<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&amp;display=swap" rel="stylesheet">
<style>
body { margin: 0; background: #e6ebf3; color: #0b1436; font-family: "Noto Sans JP", system-ui, sans-serif; font-size: 16px; line-height: 1.8; -webkit-font-smoothing: antialiased; }
a { color: #2c4fcf; }
a:hover { color: #0b1436; }
* { box-sizing: border-box; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { * { animation:none !important; } }
details summary::-webkit-details-marker { display: none; }
details summary { list-style: none; }
details.faq summary { position: relative; padding-right: 32px; }
details.faq summary::after { content: "\FF0B"; position: absolute; right: 0; top: 19px; font-size: 17px; font-weight: 800; color: #0ab1f9; line-height: 1; }
details.faq[open] summary::after { content: "\FF0D"; }
:focus { outline: none; }
:focus-visible { outline: 2px solid #2c4fcf; outline-offset: 2px; }
section[id] { scroll-margin-top: 72px; }
.sel { width: 100%; font: inherit; font-size: 16px; font-weight: 500; padding: 14px 40px 14px 16px; border: 1px solid rgba(0,0,0,0.16); background-color: #fafafa; color: #0b1436; cursor: pointer; -webkit-appearance: none; appearance: none; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%232c4fcf' stroke-width='2'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 16px center; border-radius: 4px; }
.sel:invalid { color: #8c93a8; }
.hscroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; scroll-snap-type: x mandatory; }
.hscroll::-webkit-scrollbar { display: none; }
</style>
</helmet>
<div style="max-width:430px;margin:0 auto;background:#ffffff;padding-bottom:104px;box-shadow:0 0 34px rgba(15,68,54,0.18)">
  <header style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:linear-gradient(180deg,#ffffff 0%,#fafafa 100%);position:sticky;top:0;z-index:20;border-bottom:1px solid #e6ebf3">
    <img src="assets/logo-w-gold.png" alt="W" style="height:24px;width:auto;display:block">
    <div style="font-size:11.5px;line-height:1.6;color:#5b6178;flex:1;font-weight:500">粗利600万円保証付きの<br>営業支援サービス</div>
    <details id="menu" style="position:relative;flex:none">
      <summary aria-label="メニュー" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:44px;height:40px;cursor:pointer;border:1px solid #dbe1ec;border-radius:6px;background:linear-gradient(180deg,#ffffff,#f8fbfe);box-shadow:0 2px 6px rgba(15,68,54,0.08)">
        <span style="width:20px;height:2px;background:#0b1436;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#0b1436;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#0b1436;display:block;border-radius:1px"></span>
      </summary>
      <div style="position:absolute;right:0;top:50px;width:232px;background:#ffffff;border:1px solid #e6ebf3;box-shadow:0 16px 38px rgba(15,68,54,0.22);z-index:40;overflow:hidden">
        <a href="#jisseki" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#0b1436;text-decoration:none;border-bottom:1px solid #eaf3fb">実績</a>
        <a href="#service" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#0b1436;text-decoration:none;border-bottom:1px solid #eaf3fb">サービス内容</a>
        <a href="#riyu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#0b1436;text-decoration:none;border-bottom:1px solid #eaf3fb">保証できる理由</a>
        <a href="#gyoshu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#0b1436;text-decoration:none;border-bottom:1px solid #eaf3fb">対象商材</a>
        <a href="#faq" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#0b1436;text-decoration:none;border-bottom:1px solid #eaf3fb">よくあるご質問</a>
        <div style="padding:12px">
          <a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(180deg,#ff9440 0%,#e06d00 100%);color:#fff;font-weight:900;font-size:14.5px;padding:13px 10px;border-radius:6px;text-decoration:none;line-height:1.4;box-shadow:0 4px 0 #a85200, 0 8px 20px rgba(224,109,0,0.30)" style-hover="filter:brightness(1.1);color:#fff">
            <span>無料で資料をもらう</span>
            <span style="flex:none;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:12.5px;line-height:1">&#8594;</span>
          </a>
        </div>
      </div>
    </details>
  </header>
  <section id="fv" data-screen-label="ファーストビュー" style="background:linear-gradient(180deg,#ffffff 0%,#f2fafe 38%,#ddeffc 72%,#cbe6fa 100%);padding:44px 24px 54px;color:#0b1436">
    <div style="position:relative;display:inline-block;background:linear-gradient(135deg,#e7f5fd,#cfe6f7);border:1px solid #9ecdf0;border-radius:9999px;padding:15px 28px;font-size:17.5px;font-weight:900;color:#1a2c6e;letter-spacing:0.04em;margin-bottom:26px;box-shadow:0 5px 16px rgba(11,20,54,0.14)">テレアポに限界を感じている方へ<span style="position:absolute;left:38px;bottom:-7px;width:13px;height:13px;background:#d3e8f8;border-right:1px solid #9ecdf0;border-bottom:1px solid #9ecdf0;transform:rotate(45deg);display:block"></span></div>
    <div style="display:flex;align-items:center;gap:10px;margin:0 0 2px">
      <h1 style="flex:1;min-width:0;font-size:28px;line-height:1.46;letter-spacing:0.01em;margin:0;font-weight:900;color:#0b1436;letter-spacing:0.01em">10,000社から<br><span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">決裁者をご紹介</span></h1>
      <div style="flex:none;width:126px;height:126px;border-radius:50%;border:2px dashed #9ecdf0;background:linear-gradient(180deg,#ffffff 0%,#eaf5fd 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center;align-self:center;box-shadow:0 4px 14px rgba(11,20,54,0.08)"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#6aa9d8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="8.6" cy="10" r="1.7"/><path d="M3.8 17.6 L9.6 11.8 L13.4 15.6 L16 13 L20.2 17.2"/></svg><div style="font-size:12px;font-weight:900;color:#2c4fcf;line-height:1.5;letter-spacing:0.02em">握手イラスト<br>挿入予定</div></div>
    </div>
    <div style="width:64px;height:3px;background:linear-gradient(90deg,#0ab1f9,rgba(226,105,27,0));margin:22px 0 18px"></div>
    <p style="font-size:15.5px;font-weight:900;color:#2c4fcf;margin:0 0 10px">粗利600万円保証付きの営業支援</p>
    <p style="font-size:14.5px;line-height:2.1;margin:0 0 6px;color:#444b60">10,000社以上の決裁者ネットワークから、<br>課題のある企業をピンポイントでお繋ぎします。</p>
    <div style="background:#ffffff;border:1px solid #dbe1ec;border-top:3px solid #0ab1f9;box-shadow:0 6px 20px rgba(0,0,0,0.09);padding:20px;margin:22px 0 26px">
      <div style="display:flex;align-items:baseline;gap:3px;color:#0b1436;margin-bottom:10px">
        <span style="font-size:16px;font-weight:900">粗利</span>
        <span style="font-size:40px;font-weight:900;line-height:1.05;letter-spacing:-0.01em">600</span>
        <span style="font-size:17px;font-weight:900">万円</span>
        <span style="font-size:14.5px;font-weight:900;color:#2c4fcf;margin-left:6px">達成保証</span>
      </div>
      <div style="height:1px;background:#eaf3fb;margin-bottom:11px"></div>
      <div style="font-size:14.5px;line-height:1.9;color:#444b60;font-weight:500">契約1年で届かなかった場合は、達成まで<strong style="color:#0b1436;font-weight:900">無償で支援を延長</strong>します。</div>
      <div style="font-size:12.5px;line-height:1.8;color:#8c93a8;margin-top:8px">※ 適用には事前審査（対象業種・商材の粗利率・提供体制）の通過が必要です。</div>
    </div>
<div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#2c4fcf;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#ff9440 0%,#e06d00 100%);color:#fff;font-weight:900;font-size:18px;padding:19px 14px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #a85200, 0 8px 20px rgba(224,109,0,0.30)" style-hover="filter:brightness(1.1);color:#fff"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div>
    <p style="font-size:12.5px;color:#5b6178;margin:13px 0 0;text-align:center">ご相談・審査まで費用は一切かかりません</p>
  </section>
  <section id="jisseki" data-screen-label="実績" style="background:#f8fbfe;padding:44px 0;border-top:1px solid #e6ebf3">
    <div style="padding:0 24px;text-align:center">
      <div style="display:flex;justify-content:center;margin-bottom:9px"><span style="position:relative;display:inline-block;background:#ffffff;border:1px solid #dbe1ec;border-radius:9999px;padding:12px 22px;font-size:15px;font-weight:900;color:#0b1436;letter-spacing:0.02em;box-shadow:0 4px 14px rgba(0,0,0,0.09)">粗利保証型の営業支援だから<span style="position:absolute;left:41px;bottom:-7px;width:13px;height:13px;background:#ffffff;border-right:1px solid #dbe1ec;border-bottom:1px solid #dbe1ec;transform:translateX(-50%) rotate(45deg);display:block"></span></span></div>
      <h2 style="font-size:22px;line-height:1.7;margin:0;font-weight:900;color:#0b1436">累計で<span style="font-size:33px;color:#0ab1f9">800</span>社以上に<br>導入いただいております。</h2>
      <div style="padding:6px 0 4px;margin:22px 0 26px">
        <img src="assets/emblem-10000.png" alt="代表経営者人脈 10,000社以上" style="width:290px;max-width:92%;height:auto;display:block;margin:0 auto">
        <div style="height:1px;background:linear-gradient(90deg,rgba(226,105,27,0),#0ab1f9,rgba(226,105,27,0));margin:20px 0 18px"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:center">
          <img src="assets/emblem-600.png" alt="粗利保証 600万円" style="width:100%;max-width:162px;height:auto;display:block;margin:0 auto">
          <img src="assets/emblem-800.png" alt="導入企業 800社" style="width:100%;max-width:157px;height:auto;display:block;margin:0 auto">
        </div>
      </div>
      <div style="font-size:12px;font-weight:900;color:#8c93a8;letter-spacing:0.16em;margin:0 0 12px;text-align:center">導入企業一覧</div>
    </div>
    <div style="overflow:hidden">
      <div style="display:flex;width:max-content;gap:8px;padding:2px 0;animation:marquee 30s linear infinite">
        <sc-for list="{{ marqueeTags }}" as="tag" hint-placeholder-count="8">
          <div style="background:linear-gradient(180deg,#ffffff,#f8fbfe);border:1px solid #e6ebf3;padding:9px 18px;font-size:13px;font-weight:500;white-space:nowrap;color:#444b60">{{ tag }}</div>
        </sc-for>
      </div>
    </div>
    <p style="font-size:11.5px;line-height:1.8;color:#8c93a8;margin:14px 24px 0">※ 支援業種の一例です。企業ロゴは掲載許諾が取れ次第、順次掲載します。</p>
  </section>
  <section data-screen-label="こんなお悩み" style="background:#f3f3f3;padding:46px 24px 50px;border-top:1px solid #e6ebf3">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 24px;font-weight:900;color:#0b1436;letter-spacing:0.01em">BtoBの新規開拓において<br>こんなお悩みありませんか？</h2>
    <div style="display:flex;flex-direction:column;gap:8px"><div style="display:flex;gap:13px;align-items:flex-start;background:#ffffff;border:1px solid #e6ebf3;border-left:4px solid #cfd6e4;padding:17px 18px;box-shadow:0 2px 8px rgba(0,0,0,0.05)"><span style="flex:none;width:24px;height:24px;border-radius:50%;background:#8c93a8;color:#fff;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:3px">&#10005;</span><span style="font-size:16px;font-weight:500;line-height:1.85;color:#0b1436">アポ単価3万円を払っても<br><span style="font-weight:900;color:#0b1436;background:linear-gradient(180deg,rgba(255,255,255,0) 58%,rgba(255,205,60,0.55) 58%);padding-bottom:1px">商談の質が低い</span>。</span></div><div style="display:flex;justify-content:center;margin:2px 0"><span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:10px solid #cfd6e4;display:block"></span></div><div style="display:flex;gap:13px;align-items:flex-start;background:#ffffff;border:1px solid #e6ebf3;border-left:4px solid #cfd6e4;padding:17px 18px;box-shadow:0 2px 8px rgba(0,0,0,0.05)"><span style="flex:none;width:24px;height:24px;border-radius:50%;background:#8c93a8;color:#fff;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:3px">&#10005;</span><span style="font-size:16px;font-weight:500;line-height:1.85;color:#0b1436">発注ニーズのある<br><span style="font-weight:900;color:#0b1436;background:linear-gradient(180deg,rgba(255,255,255,0) 58%,rgba(255,205,60,0.55) 58%);padding-bottom:1px">決裁者にたどり着けない</span>。</span></div><div style="display:flex;justify-content:center;margin:2px 0"><span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:10px solid #cfd6e4;display:block"></span></div><div style="display:flex;gap:13px;align-items:flex-start;background:#ffffff;border:1px solid #e6ebf3;border-left:4px solid #cfd6e4;padding:17px 18px;box-shadow:0 2px 8px rgba(0,0,0,0.05)"><span style="flex:none;width:24px;height:24px;border-radius:50%;background:#8c93a8;color:#fff;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:3px">&#10005;</span><span style="font-size:16px;font-weight:500;line-height:1.85;color:#0b1436">成果保証がなく<br><span style="font-weight:900;color:#0b1436;background:linear-gradient(180deg,rgba(255,255,255,0) 58%,rgba(255,205,60,0.55) 58%);padding-bottom:1px">投資が丸ごと損失になる</span>。</span></div></div>
  </section>
  <section id="kaiketsu" data-screen-label="Wの答え" style="background:linear-gradient(180deg,#eaf5fd 0%,#d8ecfa 100%);padding:46px 0 50px;border-top:1px solid #bfdff5">
    <div style="padding:0 24px;text-align:center">
      <h2 style="font-size:22px;line-height:1.7;margin:0 0 18px;font-weight:900;color:#0b1436;letter-spacing:0.01em"><img src="assets/logo-w-gold.png" alt="W" style="height:23px;width:auto;display:inline-block;vertical-align:-3px">に依頼すれば<span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">すべて解決</span>！</h2>
      <div style="display:flex;justify-content:center;margin-bottom:18px"><span style="position:relative;display:inline-block;background:#ffffff;border:1px solid #dbe1ec;border-radius:9999px;padding:12px 22px;font-size:15px;font-weight:900;color:#0b1436;letter-spacing:0.02em;box-shadow:0 4px 14px rgba(0,0,0,0.09)">粗利600万円 伴走保証付きで<span style="position:absolute;left:50%;bottom:-7px;width:12px;height:12px;background:#ffffff;border-right:1px solid #dbe1ec;border-bottom:1px solid #dbe1ec;transform:translateX(-50%) rotate(45deg);display:block"></span></span></div>
      <h3 style="font-size:22px;line-height:1.7;margin:0 0 14px;font-weight:900;color:#0b1436">10,000社の企業から<br>課題を持つ決裁者をご紹介</h3>
      <p style="font-size:15.5px;line-height:1.95;color:#444b60;margin:0 0 6px">10年で構築した決裁者ネットワークから、<br>あなたの商材が合致する企業をお繋ぎします。</p>
      <div style="display:flex;align-items:center;gap:8px;margin:18px 0 12px;text-align:left">
        <span style="font-size:12px;font-weight:900;color:#2c4fcf;letter-spacing:0.12em;white-space:nowrap">決裁者からの課題一覧（一部）</span>
        <span style="flex:1;height:1px;background:linear-gradient(90deg,#9ecdf0,rgba(217,195,149,0))"></span>
        <span style="font-size:12px;font-weight:500;color:#8c93a8;white-space:nowrap">横にスライド &#8594;</span>
      </div>
    </div>
    <div class="hscroll">
      <div style="display:flex;gap:10px;width:max-content;padding:4px 24px 6px"><div style="flex:none;width:268px;scroll-snap-align:start;background:linear-gradient(180deg,#ffffff 0%,#eef7fe 100%);border:1px solid #9ecdf0;box-shadow:0 3px 12px rgba(44,79,207,0.12)"><div style="display:flex;align-items:center;gap:11px;padding:13px 14px;border-bottom:1px solid #cfe6f7;background:#e3f1fc"><img src="assets/exec-1.jpg" alt="" style="flex:none;width:44px;height:44px;border-radius:50%;object-fit:cover;display:block"><span style="min-width:0"><span style="display:block;font-size:12.5px;font-weight:500;color:#8c93a8;line-height:1.5">メーカー</span><span style="display:block;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.5">代表取締役</span></span></div><div style="padding:13px 14px 15px;font-size:14.5px;font-weight:500;line-height:1.85;color:#0b1436">「大手企業の新規開拓を進めたいが、接点がない」</div></div><div style="flex:none;width:268px;scroll-snap-align:start;background:linear-gradient(180deg,#ffffff 0%,#eef7fe 100%);border:1px solid #9ecdf0;box-shadow:0 3px 12px rgba(44,79,207,0.12)"><div style="display:flex;align-items:center;gap:11px;padding:13px 14px;border-bottom:1px solid #cfe6f7;background:#e3f1fc"><img src="assets/exec-2.jpg" alt="" style="flex:none;width:44px;height:44px;border-radius:50%;object-fit:cover;display:block"><span style="min-width:0"><span style="display:block;font-size:12.5px;font-weight:500;color:#8c93a8;line-height:1.5">SaaS企業</span><span style="display:block;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.5">代表取締役</span></span></div><div style="padding:13px 14px 15px;font-size:14.5px;font-weight:500;line-height:1.85;color:#0b1436">「事業責任者クラスの採用が、半年止まっている」</div></div><div style="flex:none;width:268px;scroll-snap-align:start;background:linear-gradient(180deg,#ffffff 0%,#eef7fe 100%);border:1px solid #9ecdf0;box-shadow:0 3px 12px rgba(44,79,207,0.12)"><div style="display:flex;align-items:center;gap:11px;padding:13px 14px;border-bottom:1px solid #cfe6f7;background:#e3f1fc"><img src="assets/exec-3.jpg" alt="" style="flex:none;width:44px;height:44px;border-radius:50%;object-fit:cover;display:block"><span style="min-width:0"><span style="display:block;font-size:12.5px;font-weight:500;color:#8c93a8;line-height:1.5">人材企業</span><span style="display:block;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.5">取締役</span></span></div><div style="padding:13px 14px 15px;font-size:14.5px;font-weight:500;line-height:1.85;color:#0b1436">「広告費は上がるのに、獲得単価が改善しない」</div></div><div style="flex:none;width:268px;scroll-snap-align:start;background:linear-gradient(180deg,#ffffff 0%,#eef7fe 100%);border:1px solid #9ecdf0;box-shadow:0 3px 12px rgba(44,79,207,0.12)"><div style="display:flex;align-items:center;gap:11px;padding:13px 14px;border-bottom:1px solid #cfe6f7;background:#e3f1fc"><img src="assets/exec-4.jpg" alt="" style="flex:none;width:44px;height:44px;border-radius:50%;object-fit:cover;display:block"><span style="min-width:0"><span style="display:block;font-size:12.5px;font-weight:500;color:#8c93a8;line-height:1.5">建設業</span><span style="display:block;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.5">代表取締役</span></span></div><div style="padding:13px 14px 15px;font-size:14.5px;font-weight:500;line-height:1.85;color:#0b1436">「人手不足が深刻で、業務効率化の手段を探している」</div></div></div>
    </div>
  </section>
  <section id="service" data-screen-label="サービス概要" style="background:#ffffff;padding:46px 24px;border-top:1px solid #e6ebf3">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 14px;font-weight:900;color:#0b1436;letter-spacing:0.01em">粗利保証型の営業支援<br><img src="assets/logo-w-gold.png" alt="W" style="height:21px;width:auto;display:inline-block;vertical-align:-3px">とはどんなサービス？</h2>
    <p style="text-align:center;font-size:15.5px;line-height:1.95;color:#444b60;margin:0 0 20px">成果が出るまで伴走する、<br>粗利保証型の営業支援です。</p>
    <div id="fig-service" style="background:#ffffff;border:1px solid #e6ebf3;box-shadow:0 4px 16px rgba(0,0,0,0.07)"><div style="background:linear-gradient(160deg,#1a2c6e 0%,#0b1436 100%);padding:26px 14px 24px;text-align:center"><div style="font-size:17px;font-weight:900;color:#ffffff;line-height:1.75">投資は<span style="font-size:28px;color:#ffcd3c">300</span>万円。<br>最低<span style="font-size:28px;color:#ffcd3c">600</span>万円の粗利を保証します。</div><div style="font-size:12.5px;color:#8c93a8;line-height:1.8;margin-top:9px">届かなかった場合は達成まで無償で支援を延長します。</div></div><div style="padding:4px 18px 18px"><div style="font-size:12.5px;font-weight:700;color:#8c93a8;letter-spacing:0.1em;padding:14px 0 2px">その流れ</div><div style="display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-top:1px solid #eaf3fb"><span style="flex:none;width:26px;height:26px;border-radius:50%;background:#0b1436;color:#fff;font-size:14px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:1px">1</span><div><div style="font-size:15.5px;font-weight:700;color:#0b1436;line-height:1.6">商材をヒアリングし、審査</div><div style="font-size:14px;font-weight:500;color:#5b6178;line-height:1.85;margin-top:3px">対象業種・粗利率・提供体制を確認します。</div></div></div><div style="display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-top:1px solid #eaf3fb"><span style="flex:none;width:26px;height:26px;border-radius:50%;background:#0b1436;color:#fff;font-size:14px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:1px">2</span><div><div style="font-size:15.5px;font-weight:700;color:#0b1436;line-height:1.6">10,000社から決裁者を抽出</div><div style="font-size:14px;font-weight:500;color:#5b6178;line-height:1.85;margin-top:3px">課題・検討時期・予算感を確認済みの企業だけに絞ります。</div></div></div><div style="display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-top:1px solid #eaf3fb"><span style="flex:none;width:26px;height:26px;border-radius:50%;background:#0b1436;color:#fff;font-size:14px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:1px">3</span><div><div style="font-size:15.5px;font-weight:700;color:#0b1436;line-height:1.6">紹介として商談をセット</div><div style="font-size:14px;font-weight:500;color:#5b6178;line-height:1.85;margin-top:3px">初回から具体的な話が進む状態でお繋ぎします。</div></div></div></div></div>
  </section>
  <section id="riyu" data-screen-label="3つの理由" style="background:#f8fbfe;padding:46px 24px;border-top:1px solid #e6ebf3">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 4px;font-weight:900;color:#0b1436;letter-spacing:0.01em">粗利600万円保証を<br><span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">&ldquo;言い切れる&rdquo;3つの理由</span></h2>
<div style="padding:30px 0 26px;border-bottom:1px solid #e6ebf3;"><div style="display:flex;align-items:center;gap:11px;margin-bottom:12px"><span style="flex:none;font-weight:700;font-size:14.5px;color:#ffffff;background:linear-gradient(135deg,#2c4fcf 0%,#1a2c6e 100%);padding:5px 15px;border-radius:9999px;letter-spacing:0.06em;box-shadow:0 3px 8px rgba(44,79,207,0.28)">01</span><span style="flex:1;height:1px;background:#e6ebf3;display:block"></span></div><h3 style="font-size:21px;line-height:1.65;margin:0;font-weight:900;color:#0b1436;letter-spacing:0.01em">受けるのは、<br>成果が見込める企業だけ。</h3><div style="display:flex;flex-direction:column;gap:8px;margin-top:12px"><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">対象業種・商材の粗利率・提供体制を事前に審査</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">条件が揃った企業だけをお引き受け</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">誰にでも売らないから、保証を付けられる</span></div></div><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:18px 16px;margin-top:16px"><div style="font-size:12.5px;font-weight:900;color:#5b6178;text-align:center;margin-bottom:4px">ご相談いただく企業</div><div style="font-size:12.5px;color:#8c93a8;text-align:center;margin-bottom:11px">業種も商材もさまざま</div><div style="display:flex;justify-content:center;gap:5px;flex-wrap:wrap"><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">A社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">B社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">C社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">D社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">E社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">F社</span><span style="width:38px;height:35px;background:linear-gradient(180deg,#f3f3f3,#eaf3fb);border:1px solid #cfd6e4;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:700;color:#cfd6e4">G社</span></div><div style="display:flex;justify-content:center;margin:12px 0 10px"><span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:10px solid #cfd6e4;display:block"></span></div><div style="background:linear-gradient(135deg,#e1f2fa,#b6d9f4);border:1px solid #9ecdf0;padding:12px 14px;text-align:center"><div style="font-size:14.5px;font-weight:900;color:#1a2c6e;letter-spacing:0.08em">完全審査制</div><div style="font-size:12.5px;color:#2c4fcf;line-height:1.8;margin-top:4px">対象業種／商材の粗利率／提供体制を確認</div></div><div style="display:flex;justify-content:center;margin:10px 0 12px"><span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:10px solid #cfd6e4;display:block"></span></div><div style="font-size:12.5px;font-weight:900;color:#2c4fcf;text-align:center;margin-bottom:4px">条件が揃った企業だけをお引き受け</div><div style="font-size:12.5px;color:#8c93a8;text-align:center;margin-bottom:14px">この企業にだけ保証を適用します</div><div style="display:flex;justify-content:center;gap:16px"><span style="position:relative;width:46px;height:40px;background:#2c4fcf;display:flex;align-items:center;justify-content:center;font-size:14.5px;font-weight:900;color:#ffffff;box-shadow:0 3px 10px rgba(15,68,54,0.24)">A社<span style="position:absolute;top:-7px;right:-7px;width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);color:#ffffff;font-size:12.5px;font-weight:900;display:flex;align-items:center;justify-content:center;border:1.5px solid #ffffff">&#10003;</span></span><span style="position:relative;width:46px;height:40px;background:#2c4fcf;display:flex;align-items:center;justify-content:center;font-size:14.5px;font-weight:900;color:#ffffff;box-shadow:0 3px 10px rgba(15,68,54,0.24)">D社<span style="position:absolute;top:-7px;right:-7px;width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);color:#ffffff;font-size:12.5px;font-weight:900;display:flex;align-items:center;justify-content:center;border:1.5px solid #ffffff">&#10003;</span></span><span style="position:relative;width:46px;height:40px;background:#2c4fcf;display:flex;align-items:center;justify-content:center;font-size:14.5px;font-weight:900;color:#ffffff;box-shadow:0 3px 10px rgba(15,68,54,0.24)">F社<span style="position:absolute;top:-7px;right:-7px;width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);color:#ffffff;font-size:12.5px;font-weight:900;display:flex;align-items:center;justify-content:center;border:1.5px solid #ffffff">&#10003;</span></span></div></div></div><div style="padding:30px 0 26px;border-bottom:1px solid #e6ebf3;"><div style="display:flex;align-items:center;gap:11px;margin-bottom:12px"><span style="flex:none;font-weight:700;font-size:14.5px;color:#ffffff;background:linear-gradient(135deg,#2c4fcf 0%,#1a2c6e 100%);padding:5px 15px;border-radius:9999px;letter-spacing:0.06em;box-shadow:0 3px 8px rgba(44,79,207,0.28)">02</span><span style="flex:1;height:1px;background:#e6ebf3;display:block"></span></div><h3 style="font-size:21px;line-height:1.65;margin:0;font-weight:900;color:#0b1436;letter-spacing:0.01em">10年かけて築いた、<br>10,000社の決裁者人脈。</h3><div style="display:flex;flex-direction:column;gap:8px;margin-top:12px"><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">購入リストでも、飛び込みのアポでもない</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">10年間の直接的な関係構築で積み上げた10,000社</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">だから決裁者本人に直接つながる</span></div></div><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:18px 16px;margin-top:16px"><div style="font-size:12.5px;font-weight:900;color:#0b1436;text-align:center;margin-bottom:14px;line-height:1.7">購入リストではなく、<br>10年間の直接的な関係構築で積み上げた数です</div><div style="display:flex;flex-direction:column;gap:8px"><div style="display:flex;align-items:center;gap:9px"><span style="flex:none;width:46px;font-size:12px;font-weight:500;text-align:right;color:#5b6178">1年目</span><span style="flex:1;height:13px;background:#e6ebf3;display:block"><span style="display:block;width:8%;height:100%;background:#cfd6e4"></span></span><span style="flex:none;width:66px;text-align:left"></span></div><div style="display:flex;align-items:center;gap:9px"><span style="flex:none;width:46px;font-size:12px;font-weight:500;text-align:right;color:#5b6178">3年目</span><span style="flex:1;height:13px;background:#e6ebf3;display:block"><span style="display:block;width:26%;height:100%;background:#cfd6e4"></span></span><span style="flex:none;width:66px;text-align:left"></span></div><div style="display:flex;align-items:center;gap:9px"><span style="flex:none;width:46px;font-size:12px;font-weight:500;text-align:right;color:#5b6178">5年目</span><span style="flex:1;height:13px;background:#e6ebf3;display:block"><span style="display:block;width:50%;height:100%;background:#8c93a8"></span></span><span style="flex:none;width:66px;text-align:left"></span></div><div style="display:flex;align-items:center;gap:9px"><span style="flex:none;width:46px;font-size:12px;font-weight:500;text-align:right;color:#5b6178">7年目</span><span style="flex:1;height:13px;background:#e6ebf3;display:block"><span style="display:block;width:74%;height:100%;background:#2c4fcf"></span></span><span style="flex:none;width:66px;text-align:left"></span></div><div style="display:flex;align-items:center;gap:9px"><span style="flex:none;width:46px;font-size:12px;font-weight:900;text-align:right;color:#0b1436">10年目</span><span style="flex:1;height:13px;background:#e6ebf3;display:block"><span style="display:block;width:100%;height:100%;background:#2c4fcf"></span></span><span style="flex:none;width:66px;text-align:left"><span style="font-size:13px;font-weight:900;color:#0b1436;white-space:nowrap">10,000社</span></span></div></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid #e6ebf3;display:flex;gap:14px;justify-content:center;flex-wrap:wrap"><span style="font-size:12.5px;color:#8c93a8;font-weight:500">&#10005; 購入リスト</span><span style="font-size:12.5px;color:#8c93a8;font-weight:500">&#10005; 飛び込みアポ</span><span style="font-size:12.5px;color:#2c4fcf;font-weight:900">&#10003; 直接の関係</span></div></div></div><div style="padding:30px 0 26px;"><div style="display:flex;align-items:center;gap:11px;margin-bottom:12px"><span style="flex:none;font-weight:700;font-size:14.5px;color:#ffffff;background:linear-gradient(135deg,#2c4fcf 0%,#1a2c6e 100%);padding:5px 15px;border-radius:9999px;letter-spacing:0.06em;box-shadow:0 3px 8px rgba(44,79,207,0.28)">03</span><span style="flex:1;height:1px;background:#e6ebf3;display:block"></span></div><h3 style="font-size:21px;line-height:1.65;margin:0;font-weight:900;color:#0b1436;letter-spacing:0.01em">課題と予算を確認した<br>企業だけをご紹介。</h3><div style="display:flex;flex-direction:column;gap:8px;margin-top:12px"><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">課題・検討時期・予算感を必ずヒアリング</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">「まだ考えていない」企業は紹介しない</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">だから初回から具体的な商談になる</span></div></div><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:18px 14px;margin-top:16px"><div style="font-size:14.5px;font-weight:900;color:#0b1436;text-align:center;margin-bottom:4px">お繋ぎする前に、必ずヒアリング</div><div style="font-size:12.5px;color:#8c93a8;text-align:center;margin-bottom:14px">課題・時期・予算の3点を確認します</div><div style="display:flex;flex-direction:column;gap:12px"><div style="background:#ffffff;border:1px solid #e6ebf3;overflow:hidden"><div style="display:flex;align-items:center;gap:9px;padding:11px 14px;background:linear-gradient(90deg,#0ab1f9 0%,#2c4fcf 100%)"><span style="font-size:14.5px;font-weight:700;color:#ffffff;white-space:nowrap">ご紹介する</span><span style="font-size:16px;font-weight:900;color:#ffffff">A社</span><span style="margin-left:auto;font-size:12px;font-weight:500;color:rgba(255,255,255,0.8);white-space:nowrap">製造業｜代表取締役</span></div><div style="padding:3px 14px 6px"><div style="display:flex;align-items:center;gap:12px;padding:9px 0;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">課題</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.6">事業承継の相談先を探している</span></div><div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-top:1px solid #eaf3fb;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">時期</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.6">3ヶ月以内</span></div><div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-top:1px solid #eaf3fb;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">予算</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#0b1436;line-height:1.6">300万円〜</span></div></div><div style="padding:10px 14px;background:#f8fbfe;font-size:13px;font-weight:500;color:#0b1436">3つとも埋まっているので、初回から具体的な商談になります。</div></div><div style="display:flex;align-items:center;gap:10px"><span style="flex:1;height:1px;background:#e6ebf3;display:block"></span><span style="font-size:12.5px;font-weight:700;color:#8c93a8;letter-spacing:0.08em">一方で</span><span style="flex:1;height:1px;background:#e6ebf3;display:block"></span></div><div style="background:#ffffff;border:1px solid #e6ebf3;overflow:hidden"><div style="display:flex;align-items:center;gap:9px;padding:11px 14px;background:#8c93a8"><span style="font-size:14.5px;font-weight:700;color:#ffffff;white-space:nowrap">ご紹介しない</span><span style="font-size:16px;font-weight:900;color:#ffffff">B社</span><span style="margin-left:auto;font-size:12px;font-weight:500;color:rgba(255,255,255,0.8);white-space:nowrap">商社｜部長</span></div><div style="padding:3px 14px 6px"><div style="display:flex;align-items:center;gap:12px;padding:9px 0;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">課題</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#8c93a8;line-height:1.6">情報収集の段階</span></div><div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-top:1px solid #eaf3fb;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">時期</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#8c93a8;line-height:1.6">未定</span></div><div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-top:1px solid #eaf3fb;"><span style="flex:none;width:38px;font-size:12.5px;font-weight:500;color:#8c93a8">予算</span><span style="flex:1;font-size:14.5px;font-weight:700;color:#8c93a8;line-height:1.6">未定</span></div></div><div style="padding:10px 14px;background:#f8fbfe;font-size:13px;font-weight:500;color:#8c93a8">まだ動いていないので、条件が揃うまでお繋ぎしません。</div></div></div></div></div>  </section>
  <section data-screen-label="保証内容" style="background:#ffffff;padding:44px 24px;border-top:1px solid #e6ebf3">
    <div style="background:#ffffff;border:1px solid rgba(15,68,54,0.10);box-shadow:0 12px 32px rgba(15,68,54,0.16);position:relative;padding:30px 20px 24px;text-align:center">
      <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#0ab1f9 0%,#0ab1f9 48%,#2c4fcf 100%);color:#ffffff;font-size:13px;font-weight:900;letter-spacing:0.12em;padding:7px 22px;border-radius:9999px;white-space:nowrap;box-shadow:0 5px 14px rgba(194,84,12,0.45), inset 0 1px 0 rgba(255,255,255,0.5)">完全審査制</div>
      <div style="font-size:13px;font-weight:900;color:#2c4fcf;letter-spacing:0.1em;margin-bottom:8px">審査通過企業のみ適用</div>
      <div style="display:flex;align-items:baseline;justify-content:center;gap:2px;color:#0b1436;flex-wrap:wrap">
        <span style="font-size:17px;font-weight:900">粗利</span>
        <span style="font-size:46px;font-weight:900;line-height:1.1;letter-spacing:-0.01em">600</span>
        <span style="font-size:19px;font-weight:900">万円 達成保証</span>
      </div>
      <div style="height:1px;background:linear-gradient(90deg,rgba(224,211,180,0),#9ecdf0,rgba(224,211,180,0));margin:14px 0 12px"></div>
      <div style="font-size:14.5px;line-height:1.95;color:#0b1436;font-weight:500">契約1年で届かなかった場合は、<br><span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px;font-weight:900">達成まで無償で支援を延長</span>します。</div>
      <div style="font-size:11.5px;line-height:1.8;color:#8c93a8;margin-top:12px">※ 適用には事前審査（対象業種・広告予算・社内体制）の通過が必要です</div>
    </div>
  </section>
  <section id="gyoshu" data-screen-label="対象商材" style="background:#f8fbfe;padding:46px 24px;border-top:1px solid #e6ebf3">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 16px;font-weight:900;color:#0b1436;letter-spacing:0.01em">保証を適用できるのは、<br><span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">単価30万円以上</span>のBtoB商材です。</h2>
    <div style="margin:0 0 26px"><div style="display:flex;flex-direction:column;gap:8px;margin-top:12px"><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">30万円以上のサービスは、担当者では決まらない</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">「誰からの紹介か」で結果が変わる</span></div><div style="display:flex;gap:10px;align-items:flex-start"><span style="flex:none;width:7px;height:7px;border-radius:50%;background:linear-gradient(135deg,#0ab1f9,#2c4fcf);display:block;margin-top:9px"></span><span style="font-size:15.5px;font-weight:400;line-height:1.9;color:#444b60">だから10,000社の人脈が成約率に直結する</span></div></div></div>
    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:26px"><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:16px 18px"><div style="font-size:12.5px;font-weight:900;color:#2c4fcf;margin-bottom:10px;letter-spacing:0.08em">経営支援・専門サービス</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px"><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">経営コンサル<br>ティング</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">資金調達支援</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">M&amp;A・事業承継</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">保険・士業<br>サービス</span></div></div><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:16px 18px"><div style="font-size:12.5px;font-weight:900;color:#2c4fcf;margin-bottom:10px;letter-spacing:0.08em">法人向けサービス</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px"><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">SaaS・DX<br>ツール導入</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">広告・PR・<br>Web制作</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">人材紹介・<br>採用支援</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">研修・社員教育</span></div></div><div style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:16px 18px"><div style="font-size:12.5px;font-weight:900;color:#2c4fcf;margin-bottom:10px;letter-spacing:0.08em">設備・インフラ</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px"><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">省エネ・電力切替</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">オフィス設備・<br>什器</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">不動産・店舗開発</span><span style="background:linear-gradient(180deg,#f8fbfe,#eaf3fb);padding:9px 6px;font-size:12.5px;font-weight:700;color:#444b60;text-align:center;line-height:1.6;display:flex;align-items:center;justify-content:center">福利厚生<br>サービス</span></div></div></div>
    <div style="background:linear-gradient(180deg,#eaf3fb,#e6ebf3);border:1px solid #dbe1ec;padding:18px;margin-bottom:24px">
      <div style="font-size:14.5px;font-weight:900;color:#5b6178;margin-bottom:10px;text-align:center">相性が良くない商材もあります</div>
      <div style="font-size:14.5px;line-height:2;color:#444b60">
        <div style="display:flex;gap:8px"><span style="color:#2c4fcf;font-weight:900">&#9651;</span>一般消費者向け(BtoC)の商材</div>
        <div style="display:flex;gap:8px"><span style="color:#2c4fcf;font-weight:900">&#9651;</span>単価が低く、受注件数を多く必要とする商材</div>
      </div>
      <div style="font-size:13px;color:#5b6178;margin-top:12px;line-height:1.9">ただ、法人向けの切り口があれば対応できるケースもあります。保証の条件や進め方が変わることもあるため、まずはご相談ください。</div>
    </div>
    <div style="text-align:center">
      <p style="font-size:16px;font-weight:900;line-height:1.9;margin:0 0 4px;color:#0b1436">単価が高くて売りにくい商材ほど、<br>ご相談ください。</p>
      <p style="font-size:13px;color:#5b6178;margin:0;line-height:1.9">対象かどうかの確認は無料です。</p>
    </div>
  </section>
  <section id="faq" data-screen-label="よくあるご質問" style="background:#ffffff;padding:46px 24px;border-top:1px solid #e6ebf3">
    <h2 style="text-align:center;font-size:21px;margin:0 0 22px;font-weight:900;line-height:1.7;color:#0b1436;letter-spacing:0.01em">よくあるご質問</h2>
    <div style="display:flex;flex-direction:column;gap:8px"><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>粗利600万円が上限ということですか？</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">いいえ。600万円は「最低保証」で、創出できる粗利に上限はありません。創出した粗利はすべて御社の利益になります。</p></details><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>なぜ600万円という保証額なのですか？</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">ご投資いただく300万円の2倍を、「最低でもここまでは」という下限として設定しているためです。下振れを契約で固定しておくことで、社内や役員への説明が立つ投資判断になります。</p></details><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>どんな決裁者を紹介してもらえますか？</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">10,000社超のネットワークのうち、現在の課題・検討時期・予算感をヒアリング済みの決裁者に限定してお繋ぎします。「まだ考えていない」企業はご紹介しません。</p></details><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>審査では何を見られますか？</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">対象業種、商材の粗利率、提供体制の3点です。成果が出る条件が揃っているかを確認するためで、通過した企業のみ保証を適用します。</p></details><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>600万円に届かなかった場合はどうなりますか？</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">契約1年で届かなかった場合は、達成するまで追加費用なしで支援を延長します。契約期間中にご紹介した案件が期間終了後に受注へ至った場合も、保証粗利に含めます。</p></details><details class="faq" style="background:linear-gradient(180deg,#ffffff,#fafafa);border:1px solid #e6ebf3;box-shadow:0 3px 12px rgba(15,68,54,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#0b1436"><span style="flex:none;color:#2c4fcf;font-weight:900">Q.</span>支払い方法や途中解約について教えてください。</summary><p style="font-size:14.5px;line-height:2;color:#444b60;margin:0 0 18px;padding-left:24px;border-top:1px solid #e6ebf3;padding-top:14px">原則は一括払いですが、やむを得ない場合はご相談ください（手数料等が発生します）。年間契約のため途中解約は原則お受けしていませんが、ご事情により個別に対応します。</p></details></div>
  </section>
  <section id="contact" data-screen-label="資料ダウンロード" style="background:#0b1436;padding:52px 20px 56px;border-top:1px solid #e6ebf3">
    <div style="text-align:center">
      <img src="assets/logo-w-gold.png" alt="W" style="height:32px;width:auto;display:block;margin:0 auto 18px">
      <h2 style="font-size:22px;line-height:1.75;margin:0 0 14px;font-weight:900;color:#ffffff;letter-spacing:0.01em">まずは資料で、<br><span style="background:linear-gradient(90deg,#0ab1f9,#0ab1f9);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">保証の条件</span>をご確認ください。</h2>
      <p style="font-size:14.5px;line-height:2;margin:0 0 24px;color:#b9c0d4;font-weight:500">サービス内容・審査基準・保証の適用条件を<br>まとめた資料をお送りします。<br>ご相談・審査まで費用は一切かかりません。</p>
    </div>
    <div style="background:#ffffff;padding:24px 20px 28px;box-shadow:0 14px 34px rgba(0,0,0,0.34)">
      <div style="display:flex;align-items:center;gap:9px;margin-bottom:20px">
        <span style="width:20px;height:2px;background:linear-gradient(90deg,#0ab1f9,rgba(10,177,249,0));flex:none"></span>
        <span style="font-size:11.5px;font-weight:900;letter-spacing:0.2em;color:#2c4fcf">資料ダウンロードフォーム</span>
      </div>
      <form onSubmit="{{ handleSubmit }}" style="display:flex;flex-direction:column;gap:20px">
        <div>
          <label for="f-company" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">会社名<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-company" name="company" type="text" required placeholder="例：ラフ・メイカー株式会社" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#fafafa;color:#0b1436">
        </div>
        <div>
          <label for="f-name" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">氏名<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-name" name="name" type="text" required placeholder="例：山田 太郎" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#fafafa;color:#0b1436">
        </div>
        <div>
          <label for="f-email" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">メールアドレス<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-email" name="email" type="email" required placeholder="例：yamada@example.co.jp" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#fafafa;color:#0b1436">
        </div>
        <div>
          <label for="f-tel" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">電話番号<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-tel" name="tel" type="tel" required placeholder="例：03-1234-5678" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#fafafa;color:#0b1436">
        </div>
        <div>
          <label for="f-budget" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">予算として年間300万円以上を確保できますか？<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-budget" name="budget" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>はい</option>
            <option>いいえ</option>
          </select>
          <p style="font-size:12.5px;line-height:1.8;color:#2c4fcf;margin:8px 0 0">※誠に恐縮ながら、「いいえ」の場合は今回のご案内の対象外となります</p>
        </div>
        <div>
          <label for="f-issue" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">現在、貴社が抱えている課題を教えてください<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-issue" name="issue" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>売上が伸び悩んでいる／頭打ちになっている</option>
            <option>新規顧客・販路をうまく開拓できていない</option>
            <option>営業の人材・リソースが不足している</option>
            <option>マーケティング・ブランディングのやり方が分からない</option>
            <option>決裁者・キーマンとの人脈・つながりがない</option>
            <option>資金調達・PR・採用・DXなど経営全般に課題がある</option>
          </select>
        </div>
        <div>
          <label for="f-interest" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#0b1436">今回、特に興味を持たれた内容を教えてください<span style="background:#2c4fcf;color:#fff;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-interest" name="interest" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>いま課題のある決裁者とのマッチング・紹介</option>
            <option>代表・田口のマーケティングスキルを活用できる点</option>
            <option>企業800社・個人10,000社超のビジネス人脈</option>
            <option>ターゲットへのアプローチ代行</option>
            <option>資金調達・PR・人材・DXまで含む経営ブレインサポート</option>
            <option>粗利600万円の最低保証（下振れリスクの固定）</option>
          </select>
        </div>
        <div style="font-size:12.5px;line-height:1.9;color:#5b6178;background:#f8fbfe;border:1px solid #e6ebf3;padding:14px 16px">送信いただいた情報は、お問い合わせ対応の目的にのみ使用します。詳しくは<a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener">プライバシーポリシー</a>をご確認ください。</div>
        <div>
          <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#2c4fcf;letter-spacing:0.06em;white-space:nowrap">30秒で入力完了</span><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(20deg);border-radius:1px;flex:none"></span></div>
          <button type="submit" style="font-family:inherit;width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#ff9440 0%,#e06d00 100%);color:#fff;font-weight:900;font-size:17px;padding:19px 14px;border:none;border-radius:9999px;cursor:pointer;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #a85200, 0 8px 20px rgba(224,109,0,0.30)" style-hover="filter:brightness(1.1)"><span>無料で資料を受け取る</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></button>
        </div>
      </form>
    </div>
  </section>
  <footer style="background:#08001e;padding:34px 24px 42px;color:#b9c0d4">
    <img src="assets/logo-w-gold.png" alt="W" style="height:20px;width:auto;display:block">
    <p style="font-size:12.5px;line-height:1.8;margin:10px 0 22px;color:#b9c0d4">粗利600万円保証付きの営業支援サービス</p>
    <nav style="display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;font-size:13px;margin-bottom:22px">
      <a href="#jisseki" style="color:#e6ebf3;text-decoration:none">実績</a>
      <a href="#service" style="color:#e6ebf3;text-decoration:none">サービス内容</a>
      <a href="#riyu" style="color:#e6ebf3;text-decoration:none">保証できる理由</a>
      <a href="#gyoshu" style="color:#e6ebf3;text-decoration:none">対象商材</a>
      <a href="#faq" style="color:#e6ebf3;text-decoration:none">よくあるご質問</a>
      <a href="#contact" style="color:#e6ebf3;text-decoration:none">資料ダウンロード</a>
    </nav>
    <div style="display:flex;gap:16px;font-size:12.5px;margin-bottom:14px">
      <a href="https://laugh-maker.jp/company" target="_blank" rel="noopener" style="color:#b9c0d4;white-space:nowrap">会社概要</a>
      <a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener" style="color:#b9c0d4;white-space:nowrap">プライバシーポリシー</a>
    </div>
    <div style="font-size:11.5px;color:#8c93a8">&copy; ラフ・メイカー株式会社</div>
  </footer>
  <sc-if value="{{ barVisible }}" hint-placeholder-val="{{ false }}">
    <div style="position:fixed;bottom:0;left:0;right:0;z-index:30;display:flex;justify-content:center;background:#ffffff;border-top:2px solid #0ab1f9;box-shadow:0 -6px 20px rgba(15,68,54,0.20)">
      <div style="width:100%;max-width:430px;padding:10px 16px 12px"><div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#2c4fcf;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#2c4fcf;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#ff9440 0%,#e06d00 100%);color:#fff;font-weight:900;font-size:16px;padding:13px 12px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #a85200, 0 8px 20px rgba(224,109,0,0.30)" style-hover="filter:brightness(1.1);color:#fff"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div></div>
    </div>
  </sc-if>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { barVisible: false };
  componentDidMount() {
    this._check = () => {
      const fv = document.getElementById('fv');
      if (!fv) return;
      const form = document.getElementById('contact');
      const formNear = form && form.getBoundingClientRect().top < window.innerHeight - 60;
      const visible = fv.getBoundingClientRect().bottom < 0 && !formNear;
      if (visible !== this.state.barVisible) this.setState({ barVisible: visible });
    };
    document.addEventListener('scroll', this._check, { capture: true, passive: true });
    this._poll = setInterval(this._check, 700);
    this._check();
    this._closeMenu = (ev) => {
      const a = ev.target.closest && ev.target.closest('#menu a');
      const m = document.getElementById('menu');
      if (a && m) m.removeAttribute('open');
    };
    document.addEventListener('click', this._closeMenu);
  }
  componentWillUnmount() {
    document.removeEventListener('scroll', this._check, { capture: true });
    document.removeEventListener('click', this._closeMenu);
    clearInterval(this._poll);
  }
  renderVals() {
    const tags = ['経営コンサルティング', 'SaaS・DXツール', '資金調達支援', '省エネ・電力切替', '人材紹介・採用支援', 'M&A・事業承継', '広告・PR・Web制作', 'オフィス設備・什器', '研修・社員教育', '不動産・店舗開発', '保険・士業サービス', '福利厚生サービス'];
    return {
      barVisible: this.state.barVisible,
      marqueeTags: tags.concat(tags),
      handleSubmit: (e) => {
        e.preventDefault();
        if (e.target.checkValidity()) location.href = 'W-Thanks.dc.html';
        else e.target.reportValidity();
      }
    };
  }
}
</script>
</body>
</html>
