<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&amp;display=swap" rel="stylesheet">
<style>
body { margin: 0; background: #e4ded0; color: #241f19; font-family: "Noto Sans JP", system-ui, sans-serif; font-size: 16px; line-height: 1.8; -webkit-font-smoothing: antialiased; }
a { color: #7a5e28; }
a:hover { color: #241f19; }
* { box-sizing: border-box; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { * { animation:none !important; } }
details summary::-webkit-details-marker { display: none; }
details summary { list-style: none; }
details.faq summary { position: relative; padding-right: 32px; }
details.faq summary::after { content: "\FF0B"; position: absolute; right: 0; top: 19px; font-size: 17px; font-weight: 800; color: #b8481f; line-height: 1; }
details.faq[open] summary::after { content: "\FF0D"; }
:focus { outline: none; }
:focus-visible { outline: 2px solid #7a5e28; outline-offset: 2px; }
section[id] { scroll-margin-top: 72px; }
.sel { width: 100%; font: inherit; font-size: 16px; font-weight: 500; padding: 14px 40px 14px 16px; border: 1px solid rgba(0,0,0,0.16); background-color: #faf7f0; color: #241f19; cursor: pointer; -webkit-appearance: none; appearance: none; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%237a5e28' stroke-width='2'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 16px center; border-radius: 4px; }
.sel:invalid { color: #857e70; }
.hscroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; scroll-snap-type: x mandatory; }
.hscroll::-webkit-scrollbar { display: none; }
</style>
</helmet>
<div style="max-width:430px;margin:0 auto;background:#fffdf9;padding-bottom:104px;box-shadow:0 0 34px rgba(60,48,30,0.18)">
  <header style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:linear-gradient(180deg,#fffdf9 0%,#faf7f0 100%);position:sticky;top:0;z-index:20;border-bottom:1px solid #e4ded0">
    <img src="assets/logo-w-gold.png" alt="W" style="height:24px;width:auto;display:block">
    <div style="font-size:11.5px;line-height:1.6;color:#6a6357;flex:1;font-weight:500">粗利600万円保証付きの<br>営業支援サービス</div>
    <details id="menu" style="position:relative;flex:none">
      <summary aria-label="メニュー" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:44px;height:40px;cursor:pointer;border:1px solid #dbd4c3;border-radius:6px;background:linear-gradient(180deg,#fffdf9,#f7f4ec);box-shadow:0 2px 6px rgba(60,48,30,0.08)">
        <span style="width:20px;height:2px;background:#241f19;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#241f19;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#241f19;display:block;border-radius:1px"></span>
      </summary>
      <div style="position:absolute;right:0;top:50px;width:232px;background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 16px 38px rgba(60,48,30,0.22);z-index:40;overflow:hidden">
        <a href="#jisseki" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#241f19;text-decoration:none;border-bottom:1px solid #f1ece0">実績</a>
        <a href="#service" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#241f19;text-decoration:none;border-bottom:1px solid #f1ece0">サービス内容</a>
        <a href="#riyu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#241f19;text-decoration:none;border-bottom:1px solid #f1ece0">保証できる理由</a>
        <a href="#gyoshu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#241f19;text-decoration:none;border-bottom:1px solid #f1ece0">対象商材</a>
        <a href="#faq" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#241f19;text-decoration:none;border-bottom:1px solid #f1ece0">よくあるご質問</a>
        <div style="padding:12px">
          <a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fffdf9;font-weight:900;font-size:14.5px;padding:13px 10px;border-radius:6px;text-decoration:none;line-height:1.4;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fffdf9">
            <span>無料で資料をもらう</span>
            <span style="flex:none;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:12.5px;line-height:1">&#8594;</span>
          </a>
        </div>
      </div>
    </details>
  </header>
  <section id="fv" data-screen-label="ファーストビュー" style="background:linear-gradient(180deg,#fffdf9 0%,#f8f4ea 38%,#ece3cd 72%,#e3d8bd 100%);padding:34px 24px 44px;color:#241f19;text-align:center">
    <p style="font-size:clamp(16px,4.8vw,19px);font-weight:900;color:#3b3228;line-height:1.6;margin:0 0 18px;letter-spacing:0.02em">BtoB向け営業支援<br><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 84%,rgba(232,185,79,0.55) 84%)">粗利600万円保証付き</span></p>
    <h1 style="font-size:clamp(27px,8.2vw,36px);line-height:1.38;letter-spacing:0.01em;margin:0 0 4px;font-weight:900;color:#241f19">18,000社から<br><span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 3px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:6px">決裁者をご紹介</span></h1>
    <div style="position:relative;display:flex;align-items:center;justify-content:center;gap:14px;margin:24px 0 20px">
      <span style="position:absolute;left:0;top:50%;transform:translateY(-50%);writing-mode:vertical-rl;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.22em;line-height:1;white-space:nowrap">月間商談数</span>
      <span style="display:flex;align-items:baseline;gap:2px;color:#241f19">
        <span style="font-size:20px;font-weight:900">約</span>
        <span style="font-size:clamp(38px,11vw,50px);font-weight:900;line-height:1;letter-spacing:-0.01em;color:#b8481f">4〜5</span>
        <span style="font-size:20px;font-weight:900">件</span>
      </span>
      <img src="assets/illust/handshake.png" alt="決裁者との商談成立" style="flex:none;width:clamp(74px,21vw,96px);height:auto;display:block">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:center;margin:0 0 22px">
      <img src="assets/emblem-600.png" alt="粗利保証 600万円" style="width:100%;max-width:168px;height:auto;display:block;margin:0 auto">
      <img src="assets/emblem-800.png" alt="導入企業 800社" style="width:100%;max-width:163px;height:auto;display:block;margin:0 auto">
    </div>
<div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fffdf9;font-weight:900;font-size:18px;padding:19px 14px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fffdf9"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div>
    <p style="font-size:12.5px;color:#6a6357;margin:13px 0 0;text-align:center">ご相談・審査まで費用は一切かかりません</p>
  </section>
  <section data-screen-label="こんなお悩み" style="background:#efebe2;padding:46px 24px 54px;border-top:1px solid #e4ded0">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 30px;font-weight:900;color:#241f19;letter-spacing:0.01em">BtoBの新規開拓において<br>こんな<span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:4px">「お悩み」</span>ありませんか？</h2>
    <div style="display:flex;flex-direction:column;gap:20px">
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#a89878;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">アポ単価3万円を払っても<br>商談の質が低い</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#a89878;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#a89878;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#3b3228;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">スピード感をもって<br>決裁者に会いたい</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#3b3228;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#3b3228;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#a89878;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">発注ニーズのある<br>決裁者にたどり着けない</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#a89878;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#a89878;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#3b3228;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">テレアポの成果が<br>落ち続けている</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#3b3228;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#3b3228;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#a89878;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">成果保証がなく<br>投資が丸ごと損失になる</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#a89878;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#a89878;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#3b3228;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(60,48,30,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fffdf9">決裁者と話せないまま<br>失注してしまう</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#3b3228;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#3b3228;display:block"></span></div></div>
    </div>
  </section>
  <section id="kaiketsu" data-screen-label="Wの答え" style="background:linear-gradient(180deg,#fffdf9 0%,#f8f4ea 38%,#ece3cd 72%,#e3d8bd 100%);padding:46px 0 50px;border-top:1px solid #e0d0a8">
    <div style="padding:0 24px;text-align:center">
      <h2 style="font-size:22px;line-height:1.7;margin:0 0 18px;font-weight:900;color:#241f19;letter-spacing:0.01em"><img src="assets/logo-w-gold.png" alt="W" style="height:23px;width:auto;display:inline-block;vertical-align:-3px">に依頼すれば<span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">すべて解決</span>！</h2>
      <div style="display:flex;justify-content:center;margin-bottom:18px"><span style="position:relative;display:inline-block;background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 22px;font-size:15px;font-weight:900;color:#241f19;letter-spacing:0.02em;box-shadow:0 4px 14px rgba(0,0,0,0.09)">粗利600万円 伴走保証付きで<span style="position:absolute;left:50%;bottom:-7px;width:12px;height:12px;background:#fffdf9;border-right:1px solid #dbd4c3;border-bottom:1px solid #dbd4c3;transform:translateX(-50%) rotate(45deg);display:block"></span></span></div>
      <h3 style="font-size:22px;line-height:1.7;margin:0 0 14px;font-weight:900;color:#241f19">18,000社の企業から<br>ニーズのある決裁者をご紹介</h3>
      <p style="font-size:15.5px;line-height:1.95;color:#4a443b;margin:0 0 6px">15年で構築した決裁者ネットワークから、<br>あなたの商材が合致する企業をお繋ぎします。</p>
      <div style="background:#fffdf9;border:1px solid #e4ded0;border-top:3px solid #b8481f;box-shadow:0 4px 16px rgba(60,48,30,0.10);padding:20px 18px;margin:22px 0 4px"><div style="font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.1em;margin-bottom:8px">ご紹介する商談の本数</div><div style="display:flex;align-items:baseline;justify-content:center;gap:3px;color:#241f19;margin-bottom:4px"><span style="font-size:16px;font-weight:900">月に</span><span style="font-size:44px;font-weight:900;line-height:1.05;letter-spacing:-0.01em;color:#b8481f">4〜5</span><span style="font-size:18px;font-weight:900">件</span></div><div style="font-size:12.5px;color:#6a6357;line-height:1.8">年間平均。1年でおよそ50〜60件の商談になります。</div></div>
      <div style="display:flex;align-items:center;gap:8px;margin:26px 0 6px;text-align:left">
        <span style="font-size:12px;font-weight:900;color:#7a5e28;letter-spacing:0.12em;white-space:nowrap">ご支援実績と、ご相談時の課題</span>
        <span style="flex:1;height:1px;background:linear-gradient(90deg,#d9c69a,rgba(217,195,149,0))"></span>
      </div>
      <div style="font-size:11.5px;color:#857e70;text-align:left;margin:0 0 12px">→ 横にスワイプしてご覧いただけます</div>
      <div class="hscroll" style="display:flex;gap:12px;padding:4px 24px 14px;margin:0 -24px;text-align:left;align-items:stretch">
        <div style="flex:none;width:264px;scroll-snap-align:start;background:#fffdf9;border:1px solid #e4ded0;border-radius:10px;box-shadow:0 4px 14px rgba(60,48,30,0.09);display:flex;flex-direction:column;overflow:hidden">
          <div style="display:flex;align-items:flex-start;gap:8px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:11px 14px;min-height:62px"><span style="flex:none;width:6px;height:6px;background:#b8481f;display:block;transform:rotate(45deg);margin-top:6px"></span><span style="flex:1;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.02em;line-height:1.6">広告・クリエイティブ</span><span style="flex:none;font-size:12px;font-weight:900;color:#857e70;margin-top:1px">K様</span></div>
          <div style="padding:14px 14px 8px">
            <div style="font-size:11.5px;font-weight:900;color:#7a5e28;letter-spacing:0.14em;margin-bottom:2px">売上</div>
            <div style="display:flex;align-items:baseline;gap:2px;color:#241f19"><span style="font-size:25px;font-weight:900;line-height:1.2;letter-spacing:-0.01em;color:#b8481f">72,730,000</span><span style="font-size:14px;font-weight:900">円</span></div>
          </div>
          <div style="padding:0 14px 16px;margin-top:8px;flex:1">
            <div style="font-size:11.5px;font-weight:900;color:#fffdf9;background:#a89878;letter-spacing:0.1em;padding:3px 9px;display:inline-block;border-radius:3px;margin-bottom:7px">ご利用前の課題</div>
            <p style="font-size:13px;font-weight:500;line-height:1.85;color:#4a443b;margin:0">新たな法人案件の獲得や受注経路の拡大を図りたい</p>
          </div>
        </div>
        <div style="flex:none;width:264px;scroll-snap-align:start;background:#fffdf9;border:1px solid #e4ded0;border-radius:10px;box-shadow:0 4px 14px rgba(60,48,30,0.09);display:flex;flex-direction:column;overflow:hidden">
          <div style="display:flex;align-items:flex-start;gap:8px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:11px 14px;min-height:62px"><span style="flex:none;width:6px;height:6px;background:#b8481f;display:block;transform:rotate(45deg);margin-top:6px"></span><span style="flex:1;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.02em;line-height:1.6">補助金・助成金申請サポート</span><span style="flex:none;font-size:12px;font-weight:900;color:#857e70;margin-top:1px">Y様</span></div>
          <div style="padding:14px 14px 8px">
            <div style="font-size:11.5px;font-weight:900;color:#7a5e28;letter-spacing:0.14em;margin-bottom:2px">売上</div>
            <div style="display:flex;align-items:baseline;gap:2px;color:#241f19"><span style="font-size:25px;font-weight:900;line-height:1.2;letter-spacing:-0.01em;color:#b8481f">8,640,000</span><span style="font-size:14px;font-weight:900">円</span></div>
          </div>
          <div style="padding:0 14px 16px;margin-top:8px;flex:1">
            <div style="font-size:11.5px;font-weight:900;color:#fffdf9;background:#a89878;letter-spacing:0.1em;padding:3px 9px;display:inline-block;border-radius:3px;margin-bottom:7px">ご利用前の課題</div>
            <p style="font-size:13px;font-weight:500;line-height:1.85;color:#4a443b;margin:0">補助金・助成金の活用を検討している企業との接点を増やしたい</p>
          </div>
        </div>
        <div style="flex:none;width:264px;scroll-snap-align:start;background:#fffdf9;border:1px solid #e4ded0;border-radius:10px;box-shadow:0 4px 14px rgba(60,48,30,0.09);display:flex;flex-direction:column;overflow:hidden">
          <div style="display:flex;align-items:flex-start;gap:8px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:11px 14px;min-height:62px"><span style="flex:none;width:6px;height:6px;background:#b8481f;display:block;transform:rotate(45deg);margin-top:6px"></span><span style="flex:1;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.02em;line-height:1.6">財務システム・節税支援</span><span style="flex:none;font-size:12px;font-weight:900;color:#857e70;margin-top:1px">S様</span></div>
          <div style="padding:14px 14px 8px">
            <div style="font-size:11.5px;font-weight:900;color:#7a5e28;letter-spacing:0.14em;margin-bottom:2px">売上</div>
            <div style="display:flex;align-items:baseline;gap:2px;color:#241f19"><span style="font-size:25px;font-weight:900;line-height:1.2;letter-spacing:-0.01em;color:#b8481f">4,000,000</span><span style="font-size:14px;font-weight:900">円</span></div>
          </div>
