        <div style="font-size:12px;font-weight:900;color:#e8b94f;letter-spacing:0.18em">サービス概要</div>
      </div>
      <div style="padding:0 18px 18px">
        <div style="display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #f1ece0;"><span style="flex:none;width:104px;font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.08em">料金</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:clamp(26px,8vw,32px);font-weight:900;line-height:1;letter-spacing:-0.01em;color:#241f19">300</span><span style="font-size:15px;font-weight:900;margin-left:2px">万円</span></span></div>
        <div style="display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #f1ece0;"><span style="flex:none;width:104px;font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.08em">目標粗利</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:clamp(26px,8vw,32px);font-weight:900;line-height:1;letter-spacing:-0.01em;color:#b8481f">1,000</span><span style="font-size:15px;font-weight:900;margin-left:2px">万円〜</span></span></div>
        <div style="display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #f1ece0;"><span style="flex:none;width:104px;font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.08em">年間商談数</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:clamp(26px,8vw,32px);font-weight:900;line-height:1;letter-spacing:-0.01em;color:#241f19">40</span><span style="font-size:15px;font-weight:900;margin-left:2px">件</span></span></div>
        <div style="display:flex;align-items:center;gap:12px;padding:16px 0;"><span style="flex:none;width:104px;font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.08em">粗利保証</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:clamp(26px,8vw,32px);font-weight:900;line-height:1;letter-spacing:-0.01em;color:#b8481f">600</span><span style="font-size:15px;font-weight:900;margin-left:2px">万円</span></span></div>
        <div style="background:#f7f4ec;border:1px solid #e0d0a8;padding:12px 14px;margin-top:14px"><div style="font-size:14.5px;font-weight:900;color:#241f19;line-height:1.7">600万円は<span style="color:#b8481f">上限ではなく、下限</span>です。</div><div style="font-size:12.5px;font-weight:500;color:#6a6357;line-height:1.8;margin-top:4px">1,000万円、2,000万円と、粗利の最大化まで伴走します。創出した粗利はすべて御社の利益になります。</div></div>
      </div>
      <div style="padding:0 18px 20px">
        <div style="font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.14em;padding:2px 0 12px;border-top:1px solid #f1ece0">その流れ</div>
        <div style="display:flex;flex-direction:column;gap:8px">
        <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.08)"><div style="display:flex;align-items:center;gap:10px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:9px 14px"><span style="flex:none;background:linear-gradient(135deg,#7a5e28 0%,#3b3228 100%);color:#fffdf9;font-size:11.5px;font-weight:900;letter-spacing:0.12em;padding:4px 11px;border-radius:3px">STEP 1</span><span style="font-size:15px;font-weight:900;color:#241f19;line-height:1.5">商材をヒアリングし、審査</span></div><div style="padding:12px 14px 14px;font-size:13.5px;font-weight:500;color:#6a6357;line-height:1.85">対象業種・粗利率・提供体制を確認します。</div></div>
        <div style="display:flex;justify-content:center;margin:-2px 0"><span style="width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:9px solid #ccc4b0;display:block"></span></div>
        <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.08)"><div style="display:flex;align-items:center;gap:10px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:9px 14px"><span style="flex:none;background:linear-gradient(135deg,#7a5e28 0%,#3b3228 100%);color:#fffdf9;font-size:11.5px;font-weight:900;letter-spacing:0.12em;padding:4px 11px;border-radius:3px">STEP 2</span><span style="font-size:15px;font-weight:900;color:#241f19;line-height:1.5">18,000社から決裁者を抽出</span></div><div style="padding:12px 14px 14px;font-size:13.5px;font-weight:500;color:#6a6357;line-height:1.85">御社の商材にニーズがあるかを、一社ずつ確認します。</div></div>
        <div style="display:flex;justify-content:center;margin:-2px 0"><span style="width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:9px solid #ccc4b0;display:block"></span></div>
        <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.08)"><div style="display:flex;align-items:center;gap:10px;background:#f7f4ec;border-bottom:1px solid #e4ded0;padding:9px 14px"><span style="flex:none;background:linear-gradient(135deg,#7a5e28 0%,#3b3228 100%);color:#fffdf9;font-size:11.5px;font-weight:900;letter-spacing:0.12em;padding:4px 11px;border-radius:3px">STEP 3</span><span style="font-size:15px;font-weight:900;color:#241f19;line-height:1.5">紹介として商談をセット</span></div><div style="padding:12px 14px 14px;font-size:13.5px;font-weight:500;color:#6a6357;line-height:1.85">初回から具体的な話が進む状態でお繋ぎします。</div></div>
        </div>
      </div>
    </div>
  </section>
  <section id="riyu" data-screen-label="3つの理由" style="background:#f7f4ec;padding:46px 24px;border-top:1px solid #e4ded0">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 6px;font-weight:900;color:#241f19;letter-spacing:0.01em">粗利600万円保証を<br><span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">&ldquo;言い切れる&rdquo;3つの理由</span></h2>
    <div style="display:flex;justify-content:center;margin:18px 0 22px"><img src="assets/illust/meeting.png" alt="提案の場" style="width:300px;max-width:78%;height:auto;display:block"></div>
    <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 4px 14px rgba(60,48,30,0.08);padding:20px 18px 20px;margin:0 0 12px">
      <div style="font-size:12px;font-weight:900;color:#7a5e28;letter-spacing:0.22em;margin-bottom:8px">POINT 1</div>
      <div style="display:flex;align-items:flex-start;gap:14px">
        <div style="flex:1;min-width:0">
          <h3 style="font-size:17px;line-height:1.7;margin:0 0 10px;font-weight:900;color:#241f19;letter-spacing:0.01em"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 84%,rgba(232,185,79,0.55) 84%)">受けるのは、成果が見込める企業だけ。</span></h3>
        </div>
        <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#7a5e28" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block;flex:none"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9.5 14.5l2 2 4-4.5"/></svg>
      </div>
      <p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">対象業種・商材の<span style="font-weight:900;color:#241f19">粗利率・提供体制を事前に審査</span>します。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">条件が揃った企業だけをお引き受けしています。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 62%,rgba(232,185,79,0.55) 62%);font-weight:900;color:#241f19">誰にでも売らないから、保証を付けられる</span>のです。</p>
    </div>
    <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 4px 14px rgba(60,48,30,0.08);padding:20px 18px 20px;margin:0 0 12px">
      <div style="font-size:12px;font-weight:900;color:#7a5e28;letter-spacing:0.22em;margin-bottom:8px">POINT 2</div>
      <div style="display:flex;align-items:flex-start;gap:14px">
        <div style="flex:1;min-width:0">
          <h3 style="font-size:17px;line-height:1.7;margin:0 0 10px;font-weight:900;color:#241f19;letter-spacing:0.01em"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 84%,rgba(232,185,79,0.55) 84%)">15年かけて築いた、18,000社の決裁者人脈。</span></h3>
        </div>
        <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#7a5e28" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block;flex:none"><circle cx="6" cy="7" r="2.4"/><circle cx="18" cy="7" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M7.6 8.8l3.2 7M16.4 8.8l-3.2 7M8.4 7h7.2"/></svg>
      </div>
      <p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">購入リストでも、飛び込みのアポでもありません。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">15年間、<span style="font-weight:900;color:#241f19">一社ずつ直接会って積み上げた18,000社</span>です。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 62%,rgba(232,185,79,0.55) 62%);font-weight:900;color:#241f19">だから決裁者本人に、直接つながります。</span></p>
    </div>
    <div style="background:#fffdf9;border:1px solid #e4ded0;box-shadow:0 4px 14px rgba(60,48,30,0.08);padding:20px 18px 20px;margin:0 0 12px">
      <div style="font-size:12px;font-weight:900;color:#7a5e28;letter-spacing:0.22em;margin-bottom:8px">POINT 3</div>
      <div style="display:flex;align-items:flex-start;gap:14px">
        <div style="flex:1;min-width:0">
          <h3 style="font-size:17px;line-height:1.7;margin:0 0 10px;font-weight:900;color:#241f19;letter-spacing:0.01em"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 84%,rgba(232,185,79,0.55) 84%)">ニーズを確認できた企業だけをご紹介。</span></h3>
        </div>
        <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="#7a5e28" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block;flex:none"><path d="M4 5.5h16v11H12l-5 4v-4H4z"/><path d="M9 10.8l2 2 4-4"/></svg>
      </div>
      <p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">お繋ぎする前に、<span style="font-weight:900;color:#241f19">ニーズの有無を必ず確認</span>します。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px">「いまは考えていない」相手は紹介しません。</p><p style="font-size:14px;font-weight:500;line-height:1.9;color:#4a443b;margin:0 0 5px"><span style="background:linear-gradient(180deg,rgba(255,255,255,0) 62%,rgba(232,185,79,0.55) 62%);font-weight:900;color:#241f19">だから「探している相手」とだけ商談できます。</span></p>
    </div>
  </section>
  <section id="gyoshu" data-screen-label="対象商材" style="background:#f7f4ec;padding:46px 24px;border-top:1px solid #e4ded0">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 12px;font-weight:900;color:#241f19;letter-spacing:0.01em">これまでの支援実績は、<br><span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">BtoB商材が中心</span>です。</h2>
    <div style="display:flex;align-items:center;gap:9px;margin:30px 0 14px"><span style="flex:none;width:4px;height:17px;background:#b8481f;display:block"></span><span style="font-size:15.5px;font-weight:900;color:#241f19;letter-spacing:0.04em;white-space:nowrap">支援実績</span><span style="flex:1;height:1px;background:#e4ded0;display:block"></span></div>
    <div style="border:2px dashed #d9c69a;background:linear-gradient(180deg,#fffdf9 0%,#f9f6ee 100%);border-radius:6px;padding:26px 18px;text-align:center;margin-bottom:6px"><div style="font-size:13.5px;font-weight:900;color:#7a5e28;letter-spacing:0.06em;line-height:1.8">支援実績を掲載予定</div><div style="font-size:12.5px;color:#857e70;line-height:1.8;margin-top:4px">導入企業さまの事例をこちらに掲載します。</div></div>
    <div style="display:flex;align-items:center;gap:9px;margin:30px 0 14px"><span style="flex:none;width:4px;height:17px;background:#b8481f;display:block"></span><span style="font-size:15.5px;font-weight:900;color:#241f19;letter-spacing:0.04em;white-space:nowrap">対象になる取引の規模</span><span style="flex:1;height:1px;background:#e4ded0;display:block"></span></div>
    <div style="background:#fffdf9;border:1px solid #dbd4c3;padding:18px 16px 20px;margin:0 0 20px">
      <div style="display:flex;align-items:stretch;gap:6px">
        <div style="flex:1;min-width:0;background:#f7f4ec;border:1px solid #e0d0a8;padding:14px 8px 13px;text-align:center"><div style="font-size:11.5px;font-weight:700;color:#7a5e28;letter-spacing:0.06em;margin-bottom:6px">一括で</div><div style="font-size:21px;font-weight:900;color:#b8481f;line-height:1.25;letter-spacing:-0.01em">30<span style="font-size:14px">万円</span></div><div style="font-size:13px;font-weight:700;color:#241f19;line-height:1.6;margin-top:2px">以上</div><div style="font-size:11px;color:#6a6357;line-height:1.6;margin-top:5px">単発のご契約</div></div><div style="flex:none;width:36px;display:flex;align-items:center;justify-content:center"><span style="font-size:11.5px;font-weight:700;color:#857e70">または</span></div><div style="flex:1;min-width:0;background:#f7f4ec;border:1px solid #e0d0a8;padding:14px 8px 13px;text-align:center"><div style="font-size:11.5px;font-weight:700;color:#7a5e28;letter-spacing:0.06em;margin-bottom:6px">継続契約で</div><div style="font-size:21px;font-weight:900;color:#b8481f;line-height:1.25;letter-spacing:-0.01em">月額5<span style="font-size:14px">万円</span></div><div style="font-size:13px;font-weight:700;color:#241f19;line-height:1.6;margin-top:2px">× 12ヶ月</div><div style="font-size:11px;color:#6a6357;line-height:1.6;margin-top:5px">＝ 年間60万円</div></div>
      </div>
      <div style="display:flex;justify-content:center;margin:12px 0 10px">
        <span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:10px solid #ccc4b0;display:block"></span>
      </div>
      <div style="background:#f1ece0;border:1px solid #e0d0a8;padding:13px 12px;text-align:center">
        <span style="font-size:15px;font-weight:900;color:#241f19;line-height:1.75">どちらのかたちでも、<span style="background:linear-gradient(180deg,rgba(255,255,255,0) 58%,rgba(232,185,79,0.55) 58%);padding:0 2px 1px">保証の対象になります</span></span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:9px;margin:30px 0 14px"><span style="flex:none;width:4px;height:17px;background:#b8481f;display:block"></span><span style="font-size:15.5px;font-weight:900;color:#241f19;letter-spacing:0.04em;white-space:nowrap">粗利保証のサービス単価</span><span style="flex:1;height:1px;background:#e4ded0;display:block"></span></div>
    <div style="background:#fffdf9;border:1px solid #dbd4c3;padding:18px 16px"><div style="display:flex;align-items:center;gap:12px;padding:0 0 13px;border-bottom:1px solid #f1ece0"><span style="flex:none;width:92px;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.06em">ご投資額</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:27px;font-weight:900;line-height:1;letter-spacing:-0.01em">300</span><span style="font-size:15px;font-weight:900;margin-left:2px">万円</span></span></div><div style="display:flex;align-items:center;gap:12px;padding:13px 0 0"><span style="flex:none;width:92px;font-size:12.5px;font-weight:900;color:#7a5e28;letter-spacing:0.06em">最低保証粗利</span><span style="flex:1;text-align:right;color:#241f19"><span style="font-size:27px;font-weight:900;line-height:1;letter-spacing:-0.01em;color:#b8481f">600</span><span style="font-size:15px;font-weight:900;margin-left:2px">万円</span></span></div><div style="font-size:12.5px;color:#6a6357;line-height:1.85;margin-top:12px">600万円は下限です。創出した粗利はすべて御社の利益になります。</div></div>
    <div style="display:flex;align-items:center;gap:9px;margin:30px 0 14px"><span style="flex:none;width:4px;height:17px;background:#b8481f;display:block"></span><span style="font-size:15.5px;font-weight:900;color:#241f19;letter-spacing:0.04em;white-space:nowrap">得意な業種</span><span style="flex:1;height:1px;background:#e4ded0;display:block"></span></div>
    <p style="text-align:center;font-size:16px;font-weight:900;line-height:1.9;color:#241f19;margin:0 0 26px">担当者だけでは決まらない価格帯。<br>だから<span style="background:linear-gradient(180deg,rgba(255,255,255,0) 58%,rgba(232,185,79,0.55) 58%);padding:0 2px 1px">「誰からの紹介か」で結果が変わります</span></p>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:6px"><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">経営コンサルティング</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">資金調達支援</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">M&amp;A・事業承継</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">保険・士業サービス</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">SaaS・DXツール導入</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">広告・PR・Web制作</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">人材紹介・採用支援</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">研修・社員教育</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">省エネ・電力切替</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">オフィス設備・什器</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">不動産・店舗開発</div><div style="background:#fffdf9;border:1px solid #dbd4c3;border-radius:6px;padding:12px 8px;text-align:center;font-size:13px;font-weight:700;color:#241f19;line-height:1.5">福利厚生サービス</div></div>
    <div style="display:flex;align-items:center;gap:9px;margin:30px 0 14px"><span style="flex:none;width:4px;height:17px;background:#b8481f;display:block"></span><span style="font-size:15.5px;font-weight:900;color:#241f19;letter-spacing:0.04em;white-space:nowrap">相性の良くない業種</span><span style="flex:1;height:1px;background:#e4ded0;display:block"></span></div>
    <div style="font-size:12.5px;color:#6a6357;text-align:center;margin:0 0 12px">それぞれ、例外や判断の余地があります</div>
    <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:24px">
      <div style="background:#fffdf9;border:1px solid #e3c4bb;border-radius:6px;padding:13px 14px"><div style="display:flex;align-items:flex-start;gap:9px"><span style="flex:none;width:20px;height:20px;border-radius:50%;background:#b8481f;color:#fffdf9;font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:2px">&#10005;</span><span style="font-size:14px;font-weight:900;line-height:1.7;color:#241f19">一般消費者向け（BtoC）の商材</span></div><div style="font-size:12.5px;font-weight:500;line-height:1.85;color:#6a6357;margin:7px 0 0 29px">ただし経営者個人に向けた商材であれば、ご相談いただけます。決裁者との相性が良いためです。</div></div>
      <div style="background:#fffdf9;border:1px solid #e3c4bb;border-radius:6px;padding:13px 14px"><div style="display:flex;align-items:flex-start;gap:9px"><span style="flex:none;width:20px;height:20px;border-radius:50%;background:#b8481f;color:#fffdf9;font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:2px">&#10005;</span><span style="font-size:14px;font-weight:900;line-height:1.7;color:#241f19">対象企業が極端に限られる、ニッチな商材</span></div><div style="font-size:12.5px;font-weight:500;line-height:1.85;color:#6a6357;margin:7px 0 0 29px">ニーズのある決裁者を継続してお繋ぎできる母数があるかどうかで判断します。</div></div>
      <div style="background:#fffdf9;border:1px solid #e3c4bb;border-radius:6px;padding:13px 14px"><div style="display:flex;align-items:flex-start;gap:9px"><span style="flex:none;width:20px;height:20px;border-radius:50%;background:#b8481f;color:#fffdf9;font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:2px">&#10005;</span><span style="font-size:14px;font-weight:900;line-height:1.7;color:#241f19">単価が低く、受注件数を多く必要とする商材</span></div><div style="font-size:12.5px;font-weight:500;line-height:1.85;color:#6a6357;margin:7px 0 0 29px">件数で積み上げる商材は、紹介というやり方と噛み合いません。</div></div>
    </div>

    <div style="text-align:center">
      <p style="font-size:16px;font-weight:900;line-height:1.9;margin:0 0 4px;color:#241f19">単価が高くて売りにくい商材ほど、<br>ご相談ください。</p>
      <p style="font-size:13px;color:#6a6357;margin:0;line-height:1.9">対象かどうかの確認は無料です。</p>
    </div>
  </section>
  <section id="faq" data-screen-label="よくあるご質問" style="background:#fffdf9;padding:46px 24px;border-top:1px solid #e4ded0">
    <h2 style="text-align:center;font-size:21px;margin:0 0 22px;font-weight:900;line-height:1.7;color:#241f19;letter-spacing:0.01em">よくあるご質問</h2>
    <div style="display:flex;flex-direction:column;gap:8px"><details class="faq" style="background:linear-gradient(180deg,#fffdf9,#faf7f0);border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#241f19"><span style="flex:none;color:#7a5e28;font-weight:900">Q.</span>なぜ600万円という保証額なのですか？</summary><p style="font-size:14.5px;line-height:2;color:#4a443b;margin:0 0 18px;padding-left:24px;border-top:1px solid #e4ded0;padding-top:14px">ご投資いただく300万円の2倍を、「最低でもここまでは」という下限として設定しているためです。下振れを契約で固定しておくことで、社内や役員への説明が立つ投資判断になります。</p></details><details class="faq" style="background:linear-gradient(180deg,#fffdf9,#faf7f0);border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#241f19"><span style="flex:none;color:#7a5e28;font-weight:900">Q.</span>紹介の時点で、予算や導入時期も決まっていますか？</summary><p style="font-size:14.5px;line-height:2;color:#4a443b;margin:0 0 18px;padding-left:24px;border-top:1px solid #e4ded0;padding-top:14px">確認しているのは「ニーズがあるかどうか」です。予算や時期まで固まっているとは限りません。そこを詰めていくのが商談の役割なので、紹介の段階では「探している状態であること」を担保しています。</p></details><details class="faq" style="background:linear-gradient(180deg,#fffdf9,#faf7f0);border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#241f19"><span style="flex:none;color:#7a5e28;font-weight:900">Q.</span>600万円に届かなかった場合はどうなりますか？</summary><p style="font-size:14.5px;line-height:2;color:#4a443b;margin:0 0 18px;padding-left:24px;border-top:1px solid #e4ded0;padding-top:14px">契約1年で届かなかった場合は、達成するまで追加費用なしで支援を延長します。契約期間中にご紹介した案件が期間終了後に受注へ至った場合も、保証粗利に含めます。</p></details><details class="faq" style="background:linear-gradient(180deg,#fffdf9,#faf7f0);border:1px solid #e4ded0;box-shadow:0 3px 12px rgba(60,48,30,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#241f19"><span style="flex:none;color:#7a5e28;font-weight:900">Q.</span>支払い方法や途中解約について教えてください。</summary><p style="font-size:14.5px;line-height:2;color:#4a443b;margin:0 0 18px;padding-left:24px;border-top:1px solid #e4ded0;padding-top:14px">原則は一括払いですが、やむを得ない場合はご相談ください（手数料等が発生します）。年間契約のため途中解約は原則お受けしていませんが、ご事情により個別に対応します。</p></details></div>
  </section>
  <section id="contact" data-screen-label="資料ダウンロード" style="background:#241f19;padding:52px 20px 56px;border-top:1px solid #e4ded0">
    <div style="text-align:center">
      <img src="assets/logo-w-gold.png" alt="W" style="height:32px;width:auto;display:block;margin:0 auto 18px">
      <h2 style="font-size:22px;line-height:1.75;margin:0 0 14px;font-weight:900;color:#fffdf9;letter-spacing:0.01em">まずは資料で、<br><span style="background:linear-gradient(90deg,#b8481f,#b8481f);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">保証の条件</span>をご確認ください。</h2>
      <p style="font-size:14.5px;line-height:2;margin:0 0 24px;color:#b9b1a2;font-weight:500">サービス内容・審査基準・保証の適用条件を<br>まとめた資料をお送りします。<br>ご相談・審査まで費用は一切かかりません。</p>
    </div>
    <div style="background:#fffdf9;padding:24px 20px 28px;box-shadow:0 14px 34px rgba(0,0,0,0.34)">
      <div style="display:flex;align-items:center;gap:9px;margin-bottom:20px">
        <span style="width:20px;height:2px;background:linear-gradient(90deg,#b8481f,rgba(184,72,31,0));flex:none"></span>
        <span style="font-size:11.5px;font-weight:900;letter-spacing:0.2em;color:#7a5e28">資料ダウンロードフォーム</span>
      </div>
      <form onSubmit="{{ handleSubmit }}" style="display:flex;flex-direction:column;gap:20px">
        <div>
          <label for="f-company" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">会社名<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-company" name="company" type="text" required placeholder="例：ラフ・メイカー株式会社" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#faf7f0;color:#241f19">
        </div>
        <div>
          <label for="f-name" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">氏名<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-name" name="name" type="text" required placeholder="例：山田 太郎" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#faf7f0;color:#241f19">
        </div>
        <div>
          <label for="f-email" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">メールアドレス<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-email" name="email" type="email" required placeholder="例：yamada@example.co.jp" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#faf7f0;color:#241f19">
        </div>
        <div>
          <label for="f-tel" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">電話番号<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-tel" name="tel" type="tel" required placeholder="例：03-1234-5678" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#faf7f0;color:#241f19">
        </div>
        <div>
          <label for="f-budget" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">予算として年間300万円以上を確保できますか？<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-budget" name="budget" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>はい</option>
            <option>いいえ</option>
          </select>
          <p style="font-size:12.5px;line-height:1.8;color:#7a5e28;margin:8px 0 0">※誠に恐縮ながら、「いいえ」の場合は今回のご案内の対象外となります</p>
        </div>
        <div>
          <label for="f-issue" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">現在、貴社が抱えている課題を教えてください<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-issue" name="issue" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>売上が伸び悩んでいる／頭打ちになっている</option>
            <option>新規顧客・販路をうまく開拓できていない</option>
            <option>営業の人材・リソースが不足している</option>
            <option>マーケティング・ブランディングのやり方が分からない</option>
            <option>決裁者・キーマンとの人脈・つながりがない</option>
            <option>資金調達・PR・採用・DXなど経営全般に課題がある</option>
          </select>
        </div>
        <div>
          <label for="f-interest" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#241f19">今回、特に興味を持たれた内容を教えてください<span style="background:#7a5e28;color:#fffdf9;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-interest" name="interest" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>ニーズを確認済みの決裁者とのマッチング・紹介</option>
            <option>代表・田口のマーケティングスキルを活用できる点</option>
            <option>企業800社・15年で築いた18,000社の人脈</option>
            <option>ターゲットへのアプローチ代行</option>
            <option>資金調達・PR・人材・DXまで含む経営ブレインサポート</option>
            <option>粗利600万円の最低保証（下振れリスクの固定）</option>
          </select>
        </div>
        <div style="font-size:12.5px;line-height:1.9;color:#6a6357;background:#f7f4ec;border:1px solid #e4ded0;padding:14px 16px">送信いただいた情報は、お問い合わせ対応の目的にのみ使用します。詳しくは<a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener">プライバシーポリシー</a>をご確認ください。</div>
        <div>
          <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.06em;white-space:nowrap">30秒で入力完了</span><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(20deg);border-radius:1px;flex:none"></span></div>
          <button type="submit" style="font-family:inherit;width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fffdf9;font-weight:900;font-size:17px;padding:19px 14px;border:none;border-radius:9999px;cursor:pointer;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1)"><span>無料で資料を受け取る</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></button>
        </div>
      </form>
    </div>
  </section>
  <footer style="background:#16120d;padding:34px 24px 42px;color:#b9b1a2">
    <img src="assets/logo-w-gold.png" alt="W" style="height:20px;width:auto;display:block">
    <p style="font-size:12.5px;line-height:1.8;margin:10px 0 22px;color:#b9b1a2">粗利600万円保証付きの営業支援サービス</p>
    <nav style="display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;font-size:13px;margin-bottom:22px">
      <a href="#jisseki" style="color:#e4ded0;text-decoration:none">実績</a>
      <a href="#service" style="color:#e4ded0;text-decoration:none">サービス内容</a>
      <a href="#riyu" style="color:#e4ded0;text-decoration:none">保証できる理由</a>
      <a href="#gyoshu" style="color:#e4ded0;text-decoration:none">対象商材</a>
      <a href="#faq" style="color:#e4ded0;text-decoration:none">よくあるご質問</a>
      <a href="#contact" style="color:#e4ded0;text-decoration:none">資料ダウンロード</a>
    </nav>
    <div style="display:flex;gap:16px;font-size:12.5px;margin-bottom:14px">
      <a href="https://laugh-maker.jp/company" target="_blank" rel="noopener" style="color:#b9b1a2;white-space:nowrap">会社概要</a>
      <a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener" style="color:#b9b1a2;white-space:nowrap">プライバシーポリシー</a>
    </div>
    <div style="font-size:11.5px;color:#857e70">&copy; ラフ・メイカー株式会社</div>
  </footer>
  <sc-if value="{{ barVisible }}" hint-placeholder-val="{{ false }}">
    <div style="position:fixed;bottom:0;left:0;right:0;z-index:30;display:flex;justify-content:center;background:#fffdf9;border-top:2px solid #b8481f;box-shadow:0 -6px 20px rgba(60,48,30,0.20)">
      <div style="width:100%;max-width:430px;padding:10px 16px 12px"><div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#7a5e28;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#7a5e28;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fffdf9;font-weight:900;font-size:16px;padding:13px 12px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fffdf9"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div></div>
    </div>
  </sc-if>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { barVisible: false };
  componentDidMount() {
    this._check = () => {
      const fv = document.getElementById('fv');
      if (!fv) return;
      const form = document.getElementById('contact');
      const formNear = form && form.getBoundingClientRect().top < window.innerHeight - 60;
      const visible = fv.getBoundingClientRect().bottom < 0 && !formNear;
      if (visible !== this.state.barVisible) this.setState({ barVisible: visible });
    };
    document.addEventListener('scroll', this._check, { capture: true, passive: true });
    this._poll = setInterval(this._check, 700);
    this._check();
    this._closeMenu = (ev) => {
      const a = ev.target.closest && ev.target.closest('#menu a');
      const m = document.getElementById('menu');
      if (a && m) m.removeAttribute('open');
    };
    document.addEventListener('click', this._closeMenu);
  }
  componentWillUnmount() {
    document.removeEventListener('scroll', this._check, { capture: true });
    document.removeEventListener('click', this._closeMenu);
    clearInterval(this._poll);
  }
  renderVals() {
    const tags = ['経営コンサルティング', 'SaaS・DXツール', '資金調達支援', '省エネ・電力切替', '人材紹介・採用支援', 'M&A・事業承継', '広告・PR・Web制作', 'オフィス設備・什器', '研修・社員教育', '不動産・店舗開発', '保険・士業サービス', '福利厚生サービス'];
    return {
      barVisible: this.state.barVisible,
      marqueeTags: tags.concat(tags),
      handleSubmit: (e) => {
        e.preventDefault();
        if (e.target.checkValidity()) location.href = 'W-Thanks.dc.html';
        else e.target.reportValidity();
      }
    };
  }
}
</script>
</body>
</html>
