          <div style="position:relative;flex:1;background:#fbfefd;border:1px solid #cfe4e1;border-radius:14px;padding:56px 16px 20px;box-shadow:0 4px 16px rgba(16,48,43,0.09);overflow:hidden">
            <span aria-hidden="true" style="position:absolute;top:50px;left:14px;font-size:52px;line-height:0.7;font-weight:900;color:#e4f2f0">&ldquo;</span>
