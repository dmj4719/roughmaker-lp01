    <div style="display:flex;justify-content:center;margin:6px 0 22px"><img src="assets/illust/hearing.png" alt="商材のヒアリング" style="width:296px;max-width:78%;height:auto;display:block"></div>
    <div id="fig-service" style="background:#fbfefd;border:1px solid #cfe4e1;box-shadow:0 4px 16px rgba(16,48,43,0.09)">
      <div style="background:linear-gradient(160deg,#14403a 0%,#10302b 100%);padding:16px 16px 14px;text-align:center">
