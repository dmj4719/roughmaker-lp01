    </div>
  </section>
  <section id="faq" data-screen-label="よくあるご質問" style="background:#fbfefd;padding:46px 24px;border-top:1px solid #cfe4e1">
    <h2 style="text-align:center;font-size:21px;margin:0 0 22px;font-weight:900;line-height:1.7;color:#10302b;letter-spacing:0.01em">よくあるご質問</h2>
    <div style="display:flex;flex-direction:column;gap:8px"><details class="faq" style="background:linear-gradient(180deg,#fbfefd,#f4fbfa);border:1px solid #cfe4e1;box-shadow:0 3px 12px rgba(16,48,43,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#10302b"><span style="flex:none;color:#1d7a72;font-weight:900">Q.</span>なぜ600万円という保証額なのですか？</summary><p style="font-size:14.5px;line-height:2;color:#38534f;margin:0 0 18px;padding-left:24px;border-top:1px solid #cfe4e1;padding-top:14px">ご投資いただく300万円の2倍を、「最低でもここまでは」という下限として設定しているためです。下振れを契約で固定しておくことで、社内や役員への説明が立つ投資判断になります。</p></details><details class="faq" style="background:linear-gradient(180deg,#fbfefd,#f4fbfa);border:1px solid #cfe4e1;box-shadow:0 3px 12px rgba(16,48,43,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#10302b"><span style="flex:none;color:#1d7a72;font-weight:900">Q.</span>紹介の時点で、予算や導入時期も決まっていますか？</summary><p style="font-size:14.5px;line-height:2;color:#38534f;margin:0 0 18px;padding-left:24px;border-top:1px solid #cfe4e1;padding-top:14px">確認しているのは「ニーズがあるかどうか」です。予算や時期まで固まっているとは限りません。そこを詰めていくのが商談の役割なので、紹介の段階では「探している状態であること」を担保しています。</p></details><details class="faq" style="background:linear-gradient(180deg,#fbfefd,#f4fbfa);border:1px solid #cfe4e1;box-shadow:0 3px 12px rgba(16,48,43,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#10302b"><span style="flex:none;color:#1d7a72;font-weight:900">Q.</span>600万円に届かなかった場合はどうなりますか？</summary><p style="font-size:14.5px;line-height:2;color:#38534f;margin:0 0 18px;padding-left:24px;border-top:1px solid #cfe4e1;padding-top:14px">契約1年で届かなかった場合は、達成するまで追加費用なしで支援を延長します。契約期間中にご紹介した案件が期間終了後に受注へ至った場合も、保証粗利に含めます。</p></details><details class="faq" style="background:linear-gradient(180deg,#fbfefd,#f4fbfa);border:1px solid #cfe4e1;box-shadow:0 3px 12px rgba(16,48,43,0.06);padding:0 18px"><summary style="display:flex;gap:10px;padding:16px 30px 16px 0;font-size:14.5px;font-weight:700;cursor:pointer;line-height:1.8;color:#10302b"><span style="flex:none;color:#1d7a72;font-weight:900">Q.</span>支払い方法や途中解約について教えてください。</summary><p style="font-size:14.5px;line-height:2;color:#38534f;margin:0 0 18px;padding-left:24px;border-top:1px solid #cfe4e1;padding-top:14px">原則は一括払いですが、やむを得ない場合はご相談ください（手数料等が発生します）。年間契約のため途中解約は原則お受けしていませんが、ご事情により個別に対応します。</p></details></div>
  </section>
  <section id="contact" data-screen-label="資料ダウンロード" style="position:relative;overflow:hidden;background:repeating-linear-gradient(115deg,rgba(255,255,255,0.045) 0 2px,rgba(255,255,255,0) 2px 11px),linear-gradient(165deg,#144a43 0%,#10302b 55%,#0a241f 100%);padding:52px 20px 56px;border-top:1px solid #cfe4e1">
    <span aria-hidden="true" style="position:absolute;inset:0;overflow:hidden;display:block;pointer-events:none"><span style="position:absolute;top:-10%;right:-16%;width:76%;height:46%;background:linear-gradient(200deg,rgba(127,205,197,0.22),rgba(127,205,197,0));clip-path:polygon(26% 0,100% 14%,100% 84%,0 100%);display:block"></span><span style="position:absolute;bottom:-12%;left:-10%;width:72%;height:40%;background:linear-gradient(30deg,rgba(255,255,255,0.08),rgba(255,255,255,0));clip-path:polygon(0 30%,72% 0,100% 70%,20% 100%);display:block"></span></span>
    <div style="position:relative;text-align:center">
      <img src="assets/logo-w-gold.png" alt="W" style="height:32px;width:auto;display:block;margin:0 auto 18px">
      <h2 style="font-size:22px;line-height:1.75;margin:0 0 14px;font-weight:900;color:#fbfefd;letter-spacing:0.01em">まずは資料で、<br><span style="background:linear-gradient(90deg,#28968d,#28968d);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">保証の条件</span>をご確認ください。</h2>
      <p style="font-size:14.5px;line-height:2;margin:0 0 24px;color:#a6c2be;font-weight:500">サービス内容・審査基準・保証の適用条件を<br>まとめた資料をお送りします。<br>ご相談・審査まで費用は一切かかりません。</p>
    </div>
    <div style="background:#fbfefd;padding:24px 20px 28px;box-shadow:0 14px 34px rgba(0,0,0,0.34)">
      <div style="display:flex;align-items:center;gap:9px;margin-bottom:20px">
        <span style="width:20px;height:2px;background:linear-gradient(90deg,#28968d,rgba(5,152,141,0));flex:none"></span>
        <span style="font-size:11.5px;font-weight:900;letter-spacing:0.2em;color:#1d7a72">資料ダウンロードフォーム</span>
      </div>
      <form onSubmit="{{ handleSubmit }}" style="display:flex;flex-direction:column;gap:20px">
        <div>
          <label for="f-company" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">会社名<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-company" name="company" type="text" required placeholder="例：ラフ・メイカー株式会社" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#f4fbfa;color:#10302b">
        </div>
        <div>
          <label for="f-name" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">氏名<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-name" name="name" type="text" required placeholder="例：山田 太郎" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#f4fbfa;color:#10302b">
        </div>
        <div>
          <label for="f-email" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">メールアドレス<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-email" name="email" type="email" required placeholder="例：yamada@example.co.jp" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#f4fbfa;color:#10302b">
        </div>
        <div>
          <label for="f-tel" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">電話番号<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <input id="f-tel" name="tel" type="tel" required placeholder="例：03-1234-5678" style="width:100%;font:inherit;font-size:16px;padding:14px 16px;border:1px solid rgba(0,0,0,0.16);border-radius:4px;background:#f4fbfa;color:#10302b">
        </div>
        <div>
          <label for="f-budget" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">予算として年間300万円以上を確保できますか？<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-budget" name="budget" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>はい</option>
            <option>いいえ</option>
          </select>
          <p style="font-size:12.5px;line-height:1.8;color:#1d7a72;margin:8px 0 0">※誠に恐縮ながら、「いいえ」の場合は今回のご案内の対象外となります</p>
        </div>
        <div>
          <label for="f-issue" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">現在、貴社が抱えている課題を教えてください<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-issue" name="issue" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>売上が伸び悩んでいる／頭打ちになっている</option>
            <option>新規顧客・販路をうまく開拓できていない</option>
            <option>営業の人材・リソースが不足している</option>
            <option>マーケティング・ブランディングのやり方が分からない</option>
            <option>決裁者・キーマンとの人脈・つながりがない</option>
            <option>資金調達・PR・採用・DXなど経営全般に課題がある</option>
          </select>
        </div>
        <div>
          <label for="f-interest" style="display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin-bottom:8px;color:#10302b">今回、特に興味を持たれた内容を教えてください<span style="background:#1d7a72;color:#fbfefd;font-size:11.5px;font-weight:900;padding:2px 8px;border-radius:2px;flex:none">必須</span></label>
          <select id="f-interest" name="interest" required class="sel">
            <option value="" disabled selected>選択してください</option>
            <option>ニーズを確認済みの決裁者とのマッチング・紹介</option>
            <option>代表・田口のマーケティングスキルを活用できる点</option>
            <option>企業800社・15年で築いた18,000社の人脈</option>
            <option>ターゲットへのアプローチ代行</option>
            <option>資金調達・PR・人材・DXまで含む経営ブレインサポート</option>
            <option>粗利600万円の最低保証（下振れリスクの固定）</option>
          </select>
        </div>
        <div style="font-size:12.5px;line-height:1.9;color:#53706c;background:#eff8f6;border:1px solid #cfe4e1;padding:14px 16px">送信いただいた情報は、お問い合わせ対応の目的にのみ使用します。詳しくは<a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener">プライバシーポリシー</a>をご確認ください。</div>
        <div>
          <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#1d7a72;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#1d7a72;letter-spacing:0.06em;white-space:nowrap">30秒で入力完了</span><span style="width:2px;height:16px;background:#1d7a72;transform:rotate(20deg);border-radius:1px;flex:none"></span></div>
          <button type="submit" style="font-family:inherit;width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fbfefd;font-weight:900;font-size:17px;padding:19px 14px;border:none;border-radius:9999px;cursor:pointer;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1)"><span>無料で資料を受け取る</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></button>
        </div>
      </form>
    </div>
  </section>
  <footer style="background:#0a221e;padding:34px 24px 42px;color:#a6c2be">
    <img src="assets/logo-w-gold.png" alt="W" style="height:20px;width:auto;display:block">
    <p style="font-size:12.5px;line-height:1.8;margin:10px 0 22px;color:#a6c2be">粗利600万円保証付きの営業支援サービス</p>
    <nav style="display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;font-size:13px;margin-bottom:22px">
      <a href="#kaiketsu" style="color:#cfe4e1;text-decoration:none">実績</a>
      <a href="#service" style="color:#cfe4e1;text-decoration:none">サービス内容</a>
      <a href="#riyu" style="color:#cfe4e1;text-decoration:none">保証できる理由</a>
      <a href="#gyoshu" style="color:#cfe4e1;text-decoration:none">対象商材</a>
      <a href="#faq" style="color:#cfe4e1;text-decoration:none">よくあるご質問</a>
      <a href="#contact" style="color:#cfe4e1;text-decoration:none">資料ダウンロード</a>
    </nav>
    <div style="display:flex;gap:16px;font-size:12.5px;margin-bottom:14px">
      <a href="https://laugh-maker.jp/company" target="_blank" rel="noopener" style="color:#a6c2be;white-space:nowrap">会社概要</a>
      <a href="https://drive.google.com/file/d/1aoLPsLe9loWZZIPutqbFUnU6kxRVnT5W/view?usp=sharing" target="_blank" rel="noopener" style="color:#a6c2be;white-space:nowrap">プライバシーポリシー</a>
    </div>
    <div style="font-size:11.5px;color:#6d8d89">&copy; ラフ・メイカー株式会社</div>
  </footer>
  <sc-if value="{{ barVisible }}" hint-placeholder-val="{{ false }}">
    <div style="position:fixed;bottom:0;left:0;right:0;z-index:30;display:flex;justify-content:center;background:#fbfefd;border-top:2px solid #28968d;box-shadow:0 -6px 20px rgba(16,48,43,0.20)">
      <div style="width:100%;max-width:430px;padding:10px 16px 12px"><div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#1d7a72;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#1d7a72;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#1d7a72;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fbfefd;font-weight:900;font-size:16px;padding:13px 12px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fbfefd"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div></div>
    </div>
  </sc-if>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { barVisible: false };
  componentDidMount() {
    this._check = () => {
      const fv = document.getElementById('fv');
      if (!fv) return;
      const form = document.getElementById('contact');
      const formNear = form && form.getBoundingClientRect().top < window.innerHeight - 60;
      const visible = fv.getBoundingClientRect().bottom < 0 && !formNear;
      if (visible !== this.state.barVisible) this.setState({ barVisible: visible });
    };
    document.addEventListener('scroll', this._check, { capture: true, passive: true });
    this._poll = setInterval(this._check, 700);
    this._check();
    this._closeMenu = (ev) => {
      const a = ev.target.closest && ev.target.closest('#menu a');
      const m = document.getElementById('menu');
      if (a && m) m.removeAttribute('open');
    };
    document.addEventListener('click', this._closeMenu);
  }
  componentWillUnmount() {
    document.removeEventListener('scroll', this._check, { capture: true });
    document.removeEventListener('click', this._closeMenu);
    clearInterval(this._poll);
  }
  renderVals() {
    const tags = ['経営コンサルティング', 'SaaS・DXツール', '資金調達支援', '省エネ・電力切替', '人材紹介・採用支援', 'M&A・事業承継', '広告・PR・Web制作', 'オフィス設備・什器', '研修・社員教育', '不動産・店舗開発', '保険・士業サービス', '福利厚生サービス'];
    return {
      barVisible: this.state.barVisible,
      marqueeTags: tags.concat(tags),
      handleSubmit: (e) => {
        e.preventDefault();
        if (e.target.checkValidity()) location.href = 'W-Thanks.dc.html';
        else e.target.reportValidity();
      }
    };
  }
}
</script>
</body>
</html>
