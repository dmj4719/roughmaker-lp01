<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&amp;display=swap" rel="stylesheet">
<style>
body { margin: 0; background: #cfe4e1; color: #10302b; font-family: "Noto Sans JP", system-ui, sans-serif; font-size: 16px; line-height: 1.8; -webkit-font-smoothing: antialiased; }
a { color: #1d7a72; }
a:hover { color: #10302b; }
* { box-sizing: border-box; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { * { animation:none !important; } }
details summary::-webkit-details-marker { display: none; }
details summary { list-style: none; }
details.faq summary { position: relative; padding-right: 32px; }
details.faq summary::after { content: "\FF0B"; position: absolute; right: 0; top: 19px; font-size: 17px; font-weight: 800; color: #28968d; line-height: 1; }
details.faq[open] summary::after { content: "\FF0D"; }
:focus { outline: none; }
:focus-visible { outline: 2px solid #1d7a72; outline-offset: 2px; }
section[id] { scroll-margin-top: 72px; }
.sel { width: 100%; font: inherit; font-size: 16px; font-weight: 500; padding: 14px 40px 14px 16px; border: 1px solid rgba(0,0,0,0.16); background-color: #f4fbfa; color: #10302b; cursor: pointer; -webkit-appearance: none; appearance: none; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%231d7a72' stroke-width='2'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 16px center; border-radius: 4px; }
.sel:invalid { color: #6d8d89; }
.hscroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; scroll-snap-type: x mandatory; }
.hscroll::-webkit-scrollbar { display: none; }
</style>
</helmet>
<div style="max-width:430px;margin:0 auto;background:#fbfefd;padding-bottom:104px;box-shadow:0 0 34px rgba(16,48,43,0.18)">
  <header style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:linear-gradient(180deg,#fbfefd 0%,#f4fbfa 100%);position:sticky;top:0;z-index:20;border-bottom:1px solid #cfe4e1">
    <img src="assets/logo-w-gold.png" alt="W" style="height:24px;width:auto;display:block">
    <div style="font-size:11.5px;line-height:1.6;color:#53706c;flex:1;font-weight:500">粗利600万円保証付きの<br>営業支援サービス</div>
    <details id="menu" style="position:relative;flex:none">
      <summary aria-label="メニュー" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:44px;height:40px;cursor:pointer;border:1px solid #c2dbd7;border-radius:6px;background:linear-gradient(180deg,#fbfefd,#eff8f6);box-shadow:0 2px 6px rgba(16,48,43,0.08)">
        <span style="width:20px;height:2px;background:#10302b;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#10302b;display:block;border-radius:1px"></span>
        <span style="width:20px;height:2px;background:#10302b;display:block;border-radius:1px"></span>
      </summary>
      <div style="position:absolute;right:0;top:50px;width:232px;background:#fbfefd;border:1px solid #cfe4e1;box-shadow:0 16px 38px rgba(16,48,43,0.22);z-index:40;overflow:hidden">
        <a href="#kaiketsu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#10302b;text-decoration:none;border-bottom:1px solid #e4f2f0">実績</a>
        <a href="#service" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#10302b;text-decoration:none;border-bottom:1px solid #e4f2f0">サービス内容</a>
        <a href="#riyu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#10302b;text-decoration:none;border-bottom:1px solid #e4f2f0">保証できる理由</a>
        <a href="#gyoshu" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#10302b;text-decoration:none;border-bottom:1px solid #e4f2f0">対象商材</a>
        <a href="#faq" style="display:block;padding:13px 16px;font-size:14.5px;font-weight:700;color:#10302b;text-decoration:none;border-bottom:1px solid #e4f2f0">よくあるご質問</a>
        <div style="padding:12px">
          <a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fbfefd;font-weight:900;font-size:14.5px;padding:13px 10px;border-radius:6px;text-decoration:none;line-height:1.4;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fbfefd">
            <span>無料で資料をもらう</span>
            <span style="flex:none;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:12.5px;line-height:1">&#8594;</span>
          </a>
        </div>
      </div>
    </details>
  </header>
  <section id="fv" data-screen-label="ファーストビュー" style="background:#28968d;padding:34px 22px 30px;color:#ffffff;text-align:center">
    <p style="font-size:clamp(15px,4.4vw,18.5px);font-weight:900;color:#ffffff;line-height:1.55;margin:0 0 10px;letter-spacing:0.02em">BtoB向け営業支援・新規開拓に<br>課題を抱える企業様へ</p>
    <h1 style="font-size:clamp(31px,9.8vw,44px);line-height:1.16;letter-spacing:-0.01em;margin:0 0 16px;font-weight:900;color:#ffffff">18,000社から<br>決裁者をご紹介</h1>
    <div style="display:flex;align-items:center;justify-content:center;gap:4px;margin:0 0 20px">
      <span style="position:relative;writing-mode:vertical-rl;background:#17605a;color:#ffffff;font-size:12.5px;font-weight:900;letter-spacing:0.14em;padding:11px 6px;line-height:1;flex:none">月間商談数<span style="position:absolute;right:-9px;top:50%;transform:translateY(-50%);width:0;height:0;border-top:9px solid transparent;border-bottom:9px solid transparent;border-left:9px solid #17605a;display:block"></span></span>
      <span style="display:flex;align-items:baseline;gap:1px;color:#ffffff;margin-left:8px">
        <span style="font-size:clamp(23px,7vw,31px);font-weight:900">約</span>
        <span style="font-size:clamp(52px,16.5vw,74px);font-weight:900;line-height:1;letter-spacing:-0.02em">4〜5</span>
        <span style="font-size:clamp(23px,7vw,31px);font-weight:900">件</span>
      </span>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:center;margin:0 0 22px">
      <img src="assets/emblem-600-white.png" alt="粗利保証 600万円" style="width:100%;max-width:170px;height:auto;display:block;margin:0 auto">
      <img src="assets/emblem-800-white.png" alt="導入企業 800社" style="width:100%;max-width:165px;height:auto;display:block;margin:0 auto">
    </div>
<div><div style="display:flex;align-items:center;justify-content:center;gap:11px;margin-bottom:10px"><span style="width:2px;height:16px;background:#ffffff;transform:rotate(-20deg);border-radius:1px;flex:none"></span><span style="font-size:13px;font-weight:900;color:#ffffff;letter-spacing:0.06em;white-space:nowrap">30秒で完了</span><span style="width:2px;height:16px;background:#ffffff;transform:rotate(20deg);border-radius:1px;flex:none"></span></div><a href="#contact" style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,#c2571f 0%,#a33f12 100%);color:#fbfefd;font-weight:900;font-size:18px;padding:19px 14px;border-radius:9999px;text-decoration:none;line-height:1.5;letter-spacing:0.02em;box-shadow:0 4px 0 #7a2c0b, 0 8px 20px rgba(163,63,18,0.30)" style-hover="filter:brightness(1.1);color:#fbfefd"><span>無料で資料をダウンロード</span><span style="flex:none;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.16);border:1px solid rgba(255,255,255,0.55);display:flex;align-items:center;justify-content:center;font-size:14.5px;line-height:1">&#8594;</span></a></div>
    <p style="font-size:12.5px;color:#ffffff;margin:12px 0 0;text-align:center">ご相談・審査まで費用は一切かかりません</p>
    <div style="display:flex;flex-direction:column;align-items:center;gap:3px;margin:20px 0 0;opacity:0.85">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block"><path d="M5 8l7 7 7-7"/><path d="M5 13l7 7 7-7"/></svg>
      <span style="font-size:11px;font-weight:700;letter-spacing:0.22em;color:#ffffff">Scroll</span>
    </div>
  </section>
  <section data-screen-label="こんなお悩み" style="background:#e6f2f0;padding:46px 24px 54px;border-top:1px solid #cfe4e1">
    <h2 style="text-align:center;font-size:21px;line-height:1.75;margin:0 0 30px;font-weight:900;color:#10302b;letter-spacing:0.01em">BtoBの新規開拓において<br>こんな<span style="background:linear-gradient(90deg,#28968d,#28968d);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:4px">「お悩み」</span>ありませんか？</h2>
    <div style="display:flex;flex-direction:column;gap:20px">
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#66a7a1;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">アポ単価3万円を払っても<br>商談の質が低い</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#66a7a1;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#66a7a1;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#14403a;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">スピード感をもって<br>決裁者に会いたい</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#14403a;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#14403a;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#66a7a1;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">発注ニーズのある<br>決裁者にたどり着けない</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#66a7a1;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#66a7a1;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#14403a;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">テレアポの成果が<br>落ち続けている</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#14403a;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#14403a;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-end"><div style="position:relative;max-width:86%;background:#66a7a1;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">成果保証がなく<br>投資が丸ごと損失になる</span><span style="position:absolute;right:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#66a7a1;display:block"></span><span style="position:absolute;right:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#66a7a1;display:block"></span></div></div>
      <div style="display:flex;justify-content:flex-start"><div style="position:relative;max-width:86%;background:#14403a;border-radius:10px;padding:13px 18px;box-shadow:0 4px 12px rgba(16,48,43,0.14)"><span style="font-size:14px;font-weight:700;line-height:1.7;color:#fbfefd">決裁者と話せないまま<br>失注してしまう</span><span style="position:absolute;left:18px;bottom:-9px;width:9px;height:9px;border-radius:50%;background:#14403a;display:block"></span><span style="position:absolute;left:6px;bottom:-19px;width:6px;height:6px;border-radius:50%;background:#14403a;display:block"></span></div></div>
    </div>
  </section>
  <section id="kaiketsu" data-screen-label="Wの答え" style="background:#28968d;padding:46px 0 50px;border-top:1px solid #1d7a72">
    <div style="padding:0 24px;text-align:center">
      <h2 style="font-size:22px;line-height:1.7;margin:0 0 18px;font-weight:900;color:#ffffff;letter-spacing:0.01em"><img src="assets/logo-w-white.png" alt="W" style="height:23px;width:auto;display:inline-block;vertical-align:-3px">に依頼すれば<span style="background:linear-gradient(90deg,#ffffff,#ffffff);background-size:100% 2px;background-repeat:no-repeat;background-position:0 100%;padding-bottom:5px">すべて解決</span>！</h2>
      <div style="display:flex;justify-content:center;margin-bottom:18px"><span style="position:relative;display:inline-block;background:#fbfefd;border:1px solid #c2dbd7;border-radius:6px;padding:12px 22px;font-size:15px;font-weight:900;color:#10302b;letter-spacing:0.02em;box-shadow:0 4px 14px rgba(0,0,0,0.09)">粗利600万円 伴走保証付きで<span style="position:absolute;left:50%;bottom:-7px;width:12px;height:12px;background:#fbfefd;border-right:1px solid #c2dbd7;border-bottom:1px solid #c2dbd7;transform:translateX(-50%) rotate(45deg);display:block"></span></span></div>
      <h3 style="font-size:22px;line-height:1.7;margin:0 0 14px;font-weight:900;color:#ffffff">18,000社の企業から<br>ニーズのある決裁者をご紹介</h3>
      <p style="font-size:15.5px;line-height:1.95;color:#eaf7f5;margin:0 0 6px">15年で構築した決裁者ネットワークから、<br>あなたの商材が合致する企業をお繋ぎします。</p>
      <div style="background:#fbfefd;border:1px solid #cfe4e1;border-top:3px solid #28968d;box-shadow:0 4px 16px rgba(16,48,43,0.10);padding:20px 18px;margin:22px 0 4px"><div style="font-size:13px;font-weight:900;color:#1d7a72;letter-spacing:0.1em;margin-bottom:8px">ご紹介する商談の本数</div><div style="display:flex;align-items:baseline;justify-content:center;gap:3px;color:#10302b;margin-bottom:4px"><span style="font-size:16px;font-weight:900">月に</span><span style="font-size:44px;font-weight:900;line-height:1.05;letter-spacing:-0.01em;color:#28968d">4〜5</span><span style="font-size:18px;font-weight:900">件</span></div><div style="font-size:12.5px;color:#53706c;line-height:1.8">年間平均。1年でおよそ50〜60件の商談になります。</div></div>
      <div style="display:flex;justify-content:center;margin:28px 0 8px">
        <div style="position:relative;display:inline-flex;align-items:center;gap:12px;color:#fbfefd;padding:11px 22px;background:repeating-linear-gradient(115deg,rgba(255,255,255,0.07) 0 3px,rgba(255,255,255,0) 3px 11px),linear-gradient(135deg,#124a44 0%,#0c332e 100%);box-shadow:0 5px 14px rgba(16,48,43,0.28)"><span style="font-size:15px;font-weight:900;opacity:0.65">&#65340;</span><span style="font-size:15px;font-weight:900;letter-spacing:0.06em;white-space:nowrap">実際のお客様の課題</span><span style="font-size:15px;font-weight:900;opacity:0.65">&#65295;</span></div>
      </div>
      <div style="font-size:11.5px;color:#d9f2ef;text-align:center;margin:0 0 14px">→ 横にスワイプしてご覧いただけます</div>
      <div class="hscroll" style="display:flex;gap:12px;padding:4px 24px 14px;margin:0 -24px;text-align:left;align-items:stretch">
        <div style="flex:none;width:262px;scroll-snap-align:start;background:#fbfefd;border:1px solid #cfe4e1;border-radius:10px;box-shadow:0 4px 14px rgba(16,48,43,0.10);padding:20px 16px 18px;display:flex;flex-direction:column">
          <div style="display:flex;justify-content:center;margin-bottom:11px"><img src="assets/person/man_01.jpg" alt="" style="width:84px;height:84px;border-radius:50%;object-fit:cover;display:block;border:3px solid #ffffff;box-shadow:0 3px 10px rgba(16,48,43,0.18)"></div>
          <div style="text-align:center;font-size:11.5px;font-weight:700;color:#6d8d89;margin-bottom:3px">代表取締役</div>
          <div style="text-align:center;font-size:15px;font-weight:900;color:#1d7a72;line-height:1.6;margin-bottom:14px">メーカー</div>
          <div style="background:#eff8f6;border:1px solid #cfe4e1;border-radius:3px;padding:5px 0;text-align:center;font-size:11.5px;font-weight:900;color:#1d7a72;letter-spacing:0.1em;margin:0 0 11px">ご相談時の課題</div>
          <p style="font-size:14px;font-weight:700;line-height:1.95;color:#10302b;margin:0">「大手企業の新規開拓を進めたいが、そもそも接点がない」</p>
        </div>
        <div style="flex:none;width:262px;scroll-snap-align:start;background:#fbfefd;border:1px solid #cfe4e1;border-radius:10px;box-shadow:0 4px 14px rgba(16,48,43,0.10);padding:20px 16px 18px;display:flex;flex-direction:column">
          <div style="display:flex;justify-content:center;margin-bottom:11px"><img src="assets/person/man_02.jpg" alt="" style="width:84px;height:84px;border-radius:50%;object-fit:cover;display:block;border:3px solid #ffffff;box-shadow:0 3px 10px rgba(16,48,43,0.18)"></div>
          <div style="text-align:center;font-size:11.5px;font-weight:700;color:#6d8d89;margin-bottom:3px">代表取締役</div>
          <div style="text-align:center;font-size:15px;font-weight:900;color:#1d7a72;line-height:1.6;margin-bottom:14px">SaaS企業</div>
          <div style="background:#eff8f6;border:1px solid #cfe4e1;border-radius:3px;padding:5px 0;text-align:center;font-size:11.5px;font-weight:900;color:#1d7a72;letter-spacing:0.1em;margin:0 0 11px">ご相談時の課題</div>
          <p style="font-size:14px;font-weight:700;line-height:1.95;color:#10302b;margin:0">「事業責任者クラスの採用が、半年止まっている」</p>
        </div>
        <div style="flex:none;width:262px;scroll-snap-align:start;background:#fbfefd;border:1px solid #cfe4e1;border-radius:10px;box-shadow:0 4px 14px rgba(16,48,43,0.10);padding:20px 16px 18px;display:flex;flex-direction:column">
          <div style="display:flex;justify-content:center;margin-bottom:11px"><img src="assets/person/woman.jpg" alt="" style="width:84px;height:84px;border-radius:50%;object-fit:cover;display:block;border:3px solid #ffffff;box-shadow:0 3px 10px rgba(16,48,43,0.18)"></div>
          <div style="text-align:center;font-size:11.5px;font-weight:700;color:#6d8d89;margin-bottom:3px">取締役</div>
          <div style="text-align:center;font-size:15px;font-weight:900;color:#1d7a72;line-height:1.6;margin-bottom:14px">人材企業</div>
          <div style="background:#eff8f6;border:1px solid #cfe4e1;border-radius:3px;padding:5px 0;text-align:center;font-size:11.5px;font-weight:900;color:#1d7a72;letter-spacing:0.1em;margin:0 0 11px">ご相談時の課題</div>
          <p style="font-size:14px;font-weight:700;line-height:1.95;color:#10302b;margin:0">「広告費は上がるのに、獲得単価が改善しない」</p>
        </div>
        <div style="flex:none;width:262px;scroll-snap-align:start;background:#fbfefd;border:1px solid #cfe4e1;border-radius:10px;box-shadow:0 4px 14px rgba(16,48,43,0.10);padding:20px 16px 18px;display:flex;flex-direction:column">
          <div style="display:flex;justify-content:center;margin-bottom:11px"><img src="assets/person/man_03.jpg" alt="" style="width:84px;height:84px;border-radius:50%;object-fit:cover;display:block;border:3px solid #ffffff;box-shadow:0 3px 10px rgba(16,48,43,0.18)"></div>
          <div style="text-align:center;font-size:11.5px;font-weight:700;color:#6d8d89;margin-bottom:3px">代表取締役</div>
          <div style="text-align:center;font-size:15px;font-weight:900;color:#1d7a72;line-height:1.6;margin-bottom:14px">建設業</div>
          <div style="background:#eff8f6;border:1px solid #cfe4e1;border-radius:3px;padding:5px 0;text-align:center;font-size:11.5px;font-weight:900;color:#1d7a72;letter-spacing:0.1em;margin:0 0 11px">ご相談時の課題</div>
